---
/**
 * La ficha de un accesorio. Es la de los bolsos con lo que no aplica quitado: sin
 * color, con medidas solo si las hay y sin «Encargar uno similar», que en una pieza
 * pequeña se pregunta igual por WhatsApp.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Galeria from '../../components/Galeria.astro';
import DisenaLlavero from '../../components/DisenaLlavero.astro';
import DisenaFunda from '../../components/DisenaFunda.astro';
import site from '../../data/site.json';
import { COLORES } from '../../data/colores';
import { precio } from '../../lib/formato';
import { migasDePan, producto } from '../../lib/seo';
import { lineaAccesorio, porOrdenConVendidosAlFinal } from '../../lib/accesorios';
import { enlaceWhatsapp } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const accesorios = porOrdenConVendidosAlFinal(await getCollection('accesorios'));
  return accesorios.map((accesorio, i) => ({
    params: { slug: accesorio.id },
    props: {
      accesorio,
      anterior: accesorios[(i - 1 + accesorios.length) % accesorios.length],
      siguiente: accesorios[(i + 1) % accesorios.length],
    },
  }));
}

const { accesorio, anterior, siguiente } = Astro.props;
const d = accesorio.data;
const galeria = [d.foto, ...d.fotos, ...d.fotosColor.flatMap((c) => c.fotos)];
// A qué color pertenece cada foto de la galería; las comunes, a ninguno.
const grupos = [
  undefined,
  ...d.fotos.map(() => undefined),
  ...d.fotosColor.flatMap((c) => c.fotos.map(() => c.color)),
];

/** Colores de cordones y remates que no están en la paleta de los bolsos. */
const DE_ACCESORIOS = [{ nombre: 'Marrón', muestra: '#8A6A4F' }];
/**
 * La muestra de un color por su nombre («Rosa» → la de la paleta), si existe. Dos
 * colores con «y» («Rosa y crudo») salen como un círculo partido por la mitad.
 */
const unColor = (nombre: string) =>
  [...Object.values(COLORES), ...DE_ACCESORIOS].find(
    (c) => c.nombre.toLowerCase() === nombre.trim().toLowerCase(),
  )?.muestra;
/** «… con lazo» es otro modelo del mismo color: la muestra lleva un lazo dibujado. */
const CON_LAZO = /\s+con\s+lazo$/i;
const muestra = (nombre: string) => {
  const partes = nombre.replace(CON_LAZO, '').split(/\s+y\s+/i).map(unColor);
  if (partes.some((m) => !m || m.includes('gradient'))) return undefined;
  return partes.length === 1
    ? partes[0]
    : `linear-gradient(135deg, ${partes[0]} 0 50%, ${partes[1]} 50% 100%)`;
};
/** La opción de color se enseña con muestras, sin texto, si todos sus colores existen. */
const esColor = (o: { nombre: string; valores: string[] }) =>
  o.nombre.trim().toLowerCase() === 'color' && o.valores.every((v) => muestra(v));
const vendido = d.estado === 'vendido';
const seccion = site.secciones.accesorios;

const og = await getImage({ src: d.foto, width: 1200, format: 'jpeg' });

const linea = lineaAccesorio(accesorio);
const tresPorDos = d.tresPorDos && !vendido;

const descripcion = `${d.nombre}: ${d.material.toLowerCase()}.${d.medidas ? ` ${d.medidas}.` : ''} Accesorio hecho a mano.`;

const jsonLd = [
  producto(Astro.site!, {
    nombre: d.nombre,
    descripcion,
    imagen: og.src,
    sku: `accesorio-${accesorio.id}`,
    material: d.material,
    url: `/accesorios/${accesorio.id}`,
    oferta: { precio: d.precio, disponible: !vendido, devolucion: d.estado !== 'encargo' },
  }),
  migasDePan(Astro.site!, [
    { nombre: 'Inicio', url: '/' },
    { nombre: seccion.titulo, url: '/accesorios' },
    { nombre: d.nombre, url: `/accesorios/${accesorio.id}` },
  ]),
];
---

<Layout
  titulo={`${d.nombre} — ${site.marca}`}
  descripcion={descripcion}
  imagen={og.src}
  imagenAncho={og.attributes.width}
  imagenAlto={og.attributes.height}
  imagenAlt={`${d.nombre}, accesorio hecho a mano.`}
  jsonLd={jsonLd}
>
  <article class="px-5 py-12 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <a href="/accesorios" class="-ml-1 inline-block px-1 py-2 text-[15px] text-ink-soft no-underline hover:text-ink">
        ← {seccion.titulo}
      </a>

      <div class="mt-8 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[1.15fr_1fr]">
        <Galeria fotos={galeria} nombre={d.nombre} tipo="Accesorio" grupos={grupos} />

        <div class="lg:sticky lg:top-24">
          <h1 class="font-display text-[clamp(2.25rem,6vw,3.5rem)]">{d.nombre}</h1>

          <p class="mt-3 flex items-center gap-3 font-display text-2xl">
            {vendido ? 'Vendido' : d.estado === 'encargo' ? `Desde ${precio(d.precio)}` : precio(d.precio)}
            {tresPorDos && <span class="etiqueta-oferta">3x2</span>}
          </p>
          {
            tresPorDos && (
              <p class="mt-2 max-w-[46ch] text-[15px]" data-tres-por-dos="accesorios">
                3x2 en accesorios. Puedes mezclar los que quieras.
              </p>
            )
          }

          {d.nota && <p class="mt-3 max-w-[46ch] text-[15px] text-ink-soft">{d.nota}</p>}

          <dl class="filete mt-8 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 pt-6 text-[15px]">
            <dt class="text-ink-soft">Material</dt>
            <dd>{d.material}</dd>
            {
              d.medidas && (
                <>
                  <dt class="text-ink-soft">Medidas</dt>
                  <dd>{d.medidas}</dd>
                </>
              )
            }
          </dl>

          <div class="mt-8">
            {
              vendido ? (
                <p class="max-w-[46ch] text-[15px] text-ink-soft">
                  Esta ya tiene dueña. Si quieres una parecida,{' '}
                  <a
                    href={enlaceWhatsapp(`Hola Sakina, me gustaría un accesorio parecido a ${d.nombre}.`)}
                    class="underline"
                    target="_blank"
                    rel="noopener"
                    data-whatsapp
                  >
                    pregúntale por WhatsApp
                  </a>.
                </p>
              ) : (
                <>
                  {d.opciones.map((o, i) => (
                    <fieldset class="mb-6" data-opcion={o.nombre} data-color={esColor(o) ? '' : undefined}>
                      <legend class="text-[15px] text-ink-soft">{o.nombre}</legend>
                      <div class="mt-2.5 flex flex-wrap gap-2.5">
                        {o.valores.map((v, j) => esColor(o) ? (
                          <label class="muestra-color" title={v} style={`--muestra:${muestra(v)}`}>
                            <input
                              type="radio"
                              class="sr-only"
                              name={`opcion-${i}`}
                              value={v}
                              checked={j === 0}
                            />
                            <span aria-hidden="true" />
                            {CON_LAZO.test(v) && (
                              <svg class="lazo" viewBox="0 0 24 16" aria-hidden="true">
                                <path d="M12 8C9 3 3 1 2 4s3 7 10 4c7 3 11-1 10-4s-7-1-10 4Zm0 0-3 7m3-7 3 7" />
                              </svg>
                            )}
                            <span class="sr-only">{v}</span>
                          </label>
                        ) : (
                          <label class="opcion">
                            <input
                              type="radio"
                              class="sr-only"
                              name={`opcion-${i}`}
                              value={v}
                              checked={j === 0}
                            />
                            <span>{v}</span>
                          </label>
                        ))}
                        {/* Justo al lado de los colores ya tejidos: si ninguno convence, aquí. */}
                        {d.disena && esColor(o) && (
                          <a href="#disena-llavero" class="disena-atajo">
                            <span class="arcoiris" aria-hidden="true">+</span>
                            Diseña el tuyo
                          </a>
                        )}
                      </div>
                    </fieldset>
                  ))}
                  {/* Sin colores que elegir arriba: el atajo a «Diseña tu funda» va aquí. */}
                  {d.disenaFunda && (
                    <div class="mb-6">
                      <a href="#disena-funda" class="disena-atajo">
                        <span class="arcoiris" aria-hidden="true">+</span>
                        Diseña tu funda
                      </a>
                    </div>
                  )}
                  <button
                    type="button"
                    class="boton w-full sm:w-auto"
                    data-anadir={JSON.stringify(linea)}
                    data-base={JSON.stringify(linea)}
                    data-con-opciones={d.opciones.length > 0 ? '' : undefined}
                  >
                    Añadir al pedido
                  </button>
                  <p class="mt-3 max-w-[46ch] text-[15px] text-ink-soft">
                    {d.estado === 'encargo' ? site.fichas.aMedida : site.fichas.disponible}
                  </p>
                </>
              )
            }
          </div>

          {
            anterior.id !== accesorio.id && (
              <nav class="filete mt-10 flex justify-between gap-6 pt-6 text-[15px]" aria-label="Otros accesorios">
                <a href={`/accesorios/${anterior.id}`} class="text-ink-soft no-underline hover:text-ink">
                  ← {anterior.data.nombre}
                </a>
                <a href={`/accesorios/${siguiente.id}`} class="text-ink-soft no-underline hover:text-ink">
                  {siguiente.data.nombre} →
                </a>
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </article>
  {d.disena && <DisenaLlavero precio={d.precio} slug={accesorio.id} />}
  {d.disenaFunda && <DisenaFunda precio={d.precio} slug={accesorio.id} />}
</Layout>

<style>
  .opcion span {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 15px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: pointer;
    transition:
      background-color 180ms var(--ease-salida),
      color 180ms var(--ease-salida),
      box-shadow 180ms var(--ease-salida);
  }
  .opcion:hover span {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .opcion input:checked + span {
    background-color: var(--color-deep);
    color: var(--color-paper);
    box-shadow: none;
  }
  .disena-atajo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1rem 0 0;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms var(--ease-salida);
  }
  .disena-atajo:hover {
    background-color: color-mix(in srgb, var(--color-line) 40%, transparent);
  }
  .arcoiris {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: conic-gradient(#f28a76, #f5b301, #5f7a52, #2fb0a2, #7b5ea7, #be1f26, #f28a76);
    color: #fff;
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }
  .muestra-color span[aria-hidden] {
    display: block;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgb(31 29 27 / 0.18);
    cursor: pointer;
    transition: box-shadow 180ms var(--ease-salida);
  }
  .muestra-color {
    position: relative;
  }
  .muestra-color .lazo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 18px;
    translate: -50% -50%;
    fill: var(--color-paper);
    stroke: rgb(31 29 27 / 0.55);
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
    pointer-events: none;
  }
  .muestra-color input:checked + span {
    box-shadow:
      inset 0 0 0 1px rgb(31 29 27 / 0.18),
      0 0 0 3px var(--color-paper),
      0 0 0 5px var(--color-ink);
  }
  .muestra-color input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 5px;
  }
  .opcion input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>

<script>
  /*
   * Con opciones (color, formato…), lo elegido entra en la línea del pedido: en el
   * detalle, para que llegue escrito por WhatsApp, y en el id, para que se puedan pedir
   * a la vez dos combinaciones distintas de la misma pieza.
   */
  import { contiene, cuantasTresPorDos, suscribir } from '../../lib/carrito';

  const boton = document.querySelector<HTMLButtonElement>('[data-con-opciones]');
  if (boton) {
    const base = JSON.parse(boton.dataset.base!);
    const grupos = [...document.querySelectorAll<HTMLFieldSetElement>('[data-opcion]')];
    const limpio = (t: string) =>
      t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

    const actualizar = () => {
      const elegidas = grupos.map((g) => ({
        nombre: g.dataset.opcion!,
        valor: g.querySelector<HTMLInputElement>('input:checked')?.value ?? '',
      }));
      const linea = {
        ...base,
        id: [base.id, ...elegidas.map((e) => limpio(e.valor))].join('-'),
        detalle: [elegidas.map((e) => `${e.nombre}: ${e.valor}`).join(' · '), base.detalle]
          .filter(Boolean)
          .join(' · '),
      };
      boton.dataset.anadir = JSON.stringify(linea);
      boton.textContent = contiene(linea.id) ? 'Quitar del pedido' : 'Añadir al pedido';
    };

    /** Al elegir color, la galería pasa a las fotos de ese color. */
    const colores = document.querySelector<HTMLFieldSetElement>('[data-opcion][data-color]');
    const avisarColor = (saltar: boolean) => {
      const elegido = colores?.querySelector<HTMLInputElement>('input:checked')?.value ?? null;
      document.dispatchEvent(new CustomEvent('galeria:grupo', { detail: { nombre: elegido, saltar } }));
    };
    colores?.addEventListener('change', () => avisarColor(true));

    for (const g of grupos) g.addEventListener('change', actualizar);
    actualizar();
    // Después de que la galería haya montado su script.
    if (colores) setTimeout(() => avisarColor(false), 0);
  }

  /** Con 3x2, la frase de la oferta cuenta cuántas lleva ya y cuánto le falta. */
  const oferta = document.querySelector<HTMLElement>('[data-tres-por-dos]');
  if (oferta) {
    const grupo = oferta.dataset.tresPorDos!;
    const inicial = oferta.textContent!.trim().replace(/\s+/g, ' ');
    suscribir(() => {
      const n = cuantasTresPorDos(grupo);
      const gratis = Math.floor(n / 3);
      oferta.textContent =
        n === 0
          ? inicial
          : n % 3 === 1
            ? `3x2: llevas ${n} ${n === 1 ? 'accesorio' : 'accesorios'} en el pedido. Añade 2 más y el más barato te sale gratis.`
            : n % 3 === 2
              ? `3x2: llevas ${n} accesorios en el pedido. Con uno más, el más barato te sale gratis.`
              : `3x2: llevas ${n} accesorios en el pedido. ${gratis === 1 ? 'El más barato te sale gratis' : `Los ${gratis} más baratos te salen gratis`}.`;
    });
  }
</script>
