---
import { getImage } from 'astro:assets';
import Intro from '../components/Intro.astro';
import Portada from '../components/Portada.astro';
import FranjaAccesorios from '../components/FranjaAccesorios.astro';
import Sociales from '../components/Sociales.astro';
import Taller from '../components/Taller.astro';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import compartir from '../assets/marca/compartir.jpg';

/*
 * Lo que se ve al pasar el enlace de la web por WhatsApp: la misma pantalla con la que
 * se abre la portada, el nombre sobre el fondo gris y la frase debajo. Es una imagen
 * hecha aparte (1200×630, la medida de estas vistas previas) a partir del logotipo; si
 * cambia la frase de la portada, hay que rehacerla. Las fichas de cada pieza siguen
 * enseñando su propia foto.
 */
const og = await getImage({ src: compartir, width: 1200, format: 'jpeg' });
---

<Layout
  titulo={`${site.marca} — bolsos de ganchillo hechos a mano`}
  imagen={og.src}
  imagenAncho={og.attributes.width}
  imagenAlto={og.attributes.height}
  imagenAlt={`${site.marca}. ${site.frasePortada}`}
>
  <Intro />
  <Portada />
  <FranjaAccesorios />
  <Sociales />
  <Taller />
</Layout>
