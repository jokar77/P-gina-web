---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Portada from '../components/Portada.astro';
import Sociales from '../components/Sociales.astro';
import Taller from '../components/Taller.astro';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

// Los bolsos van primero en la portada, así que son también la imagen que se comparte.
const { data: fotosPortones } = (await getCollection('portada'))[0]!;
const og = await getImage({ src: fotosPortones.bolsos, width: 1200, format: 'jpeg' });
---

<Layout
  titulo={`${site.marca} — bolsos de ganchillo hechos a mano`}
  imagen={og.src}
  imagenAncho={og.attributes.width}
  imagenAlto={og.attributes.height}
  imagenAlt={fotosPortones.bolsosAlt || 'Bolsos de ganchillo.'}
>
  <Portada />
  <Sociales />
  <Taller />
</Layout>
