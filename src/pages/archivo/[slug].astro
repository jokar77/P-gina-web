---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Galeria from '../../components/Galeria.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const piezas = (await getCollection('archivo')).sort((a, b) => a.data.orden - b.data.orden);
  return piezas.map((pieza, i) => ({
    params: { slug: pieza.id },
    props: {
      pieza,
      cuantas: piezas.length,
      anterior: piezas[(i - 1 + piezas.length) % piezas.length],
      siguiente: piezas[(i + 1) % piezas.length],
    },
  }));
}

const { pieza, anterior, siguiente, cuantas } = Astro.props;
const d = pieza.data;
const galeria = [d.foto, ...d.fotos];
const og = await getImage({ src: d.foto, width: 1200, format: 'jpeg' });

/**
 * No se compra: se pregunta. Va al mismo pedido que todo lo demás para no inventar un
 * segundo camino —quien mira ya sabe cómo funciona el de las piezas vendidas—, y sin
 * precio, porque esto no tiene uno hasta que se hable.
 */
const linea = {
  id: `archivo-${pieza.id}`,
  nombre: `Pregunta por ${d.nombre}`,
  precio: 0,
  detalle: d.tipo,
  url: `/archivo/${pieza.id}`,
  consultar: true,
};

const descripcion = `${d.nombre}: ${d.tipo.toLowerCase()}${d.material ? `, ${d.material.toLowerCase()}` : ''}. Pieza hecha a mano por ${site.marca}.`;
---

<Layout titulo={`${d.nombre} — ${site.marca}`} descripcion={descripcion} imagen={og.src}>
  <article class="px-5 py-12 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <a
        href="/archivo"
        class="-ml-1 inline-block px-1 py-2 text-[15px] text-ink-soft no-underline hover:text-ink"
      >
        ← {site.secciones.archivo.titulo}
      </a>

      <div class="mt-8 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[1.15fr_1fr]">
        <Galeria fotos={galeria} nombre={d.nombre} tipo={d.tipo} />

        <div class="lg:sticky lg:top-24">
          <p class="font-sans text-[13px] tracking-[0.16em] text-ink-soft uppercase">{d.tipo}</p>
          <h1 class="mt-2 font-display text-[clamp(2.25rem,6vw,3.5rem)]">{d.nombre}</h1>

          {d.nota && <p class="mt-5 max-w-[52ch] text-lg">{d.nota}</p>}

          {
            (d.material || d.ano) && (
              <dl class="filete mt-8 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 pt-6 text-[15px]">
                {d.material && (
                  <>
                    <dt class="text-ink-soft">Material</dt>
                    <dd>{d.material}</dd>
                  </>
                )}
                {d.ano && (
                  <>
                    <dt class="text-ink-soft">Año</dt>
                    <dd>{d.ano}</dd>
                  </>
                )}
              </dl>
            )
          }

          <div class="mt-8">
            <button
              type="button"
              class="boton w-full sm:w-auto"
              data-anadir={JSON.stringify(linea)}
              data-etiqueta="Preguntar por esta pieza"
            >
              Preguntar por esta pieza
            </button>
            <p class="mt-3 max-w-[46ch] text-[15px] text-ink-soft">{site.fichas.archivo}</p>
          </div>

          {/*
            Con dos piezas, «anterior» y «siguiente» son la misma y el pie quedaba
            «← Oliva ... Oliva →», que parece un error. Con dos se enseña un solo
            enlace; con una, ninguno: no hay adonde ir.
          */}
          {
            cuantas > 1 && (
              <nav
                class="filete mt-10 flex justify-between gap-6 pt-6 text-[15px]"
                aria-label="Otras piezas"
              >
                {cuantas > 2 && (
                  <a
                    href={`/archivo/${anterior.id}`}
                    class="text-ink-soft no-underline hover:text-ink"
                  >
                    ← {anterior.data.nombre}
                  </a>
                )}
                <a
                  href={`/archivo/${siguiente.id}`}
                  class="ml-auto text-ink-soft no-underline hover:text-ink"
                >
                  {siguiente.data.nombre} →
                </a>
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </article>
</Layout>
