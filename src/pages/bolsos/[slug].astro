---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { COLORES, type ColorId } from '../../data/colores';
import site from '../../data/site.json';
import { medidas, precio } from '../../lib/formato';

export async function getStaticPaths() {
  const bolsos = (await getCollection('bolsos')).sort((a, b) => a.data.orden - b.data.orden);
  return bolsos.map((bolso, i) => ({
    params: { slug: bolso.id },
    props: {
      bolso,
      anterior: bolsos[(i - 1 + bolsos.length) % bolsos.length],
      siguiente: bolsos[(i + 1) % bolsos.length],
    },
  }));
}

const { bolso, anterior, siguiente } = Astro.props;
const d = bolso.data;
const galeria = [d.foto, ...d.fotos];
const color = COLORES[d.color as ColorId];
const vendido = d.estado === 'vendido';

const og = await getImage({ src: d.foto, width: 1200, format: 'jpeg' });

const linea = {
  id: bolso.id,
  nombre: d.nombre,
  precio: d.precio,
  detalle: `${d.material} · ${medidas(d.ancho, d.alto)}`,
  url: `/bolsos/${bolso.id}`,
};

/**
 * La pieza vendida no se puede pedir, pero sí una parecida. Va al mismo pedido que todo
 * lo demás, con id propio para que no choque con la pieza original, y con el precio
 * marcado como orientativo: es un encargo nuevo, tejido de cero, y no sale idéntico.
 */
const lineaSimilar = {
  id: `${bolso.id}-similar`,
  nombre: `Uno parecido a ${d.nombre}`,
  precio: d.precio,
  detalle: `${d.material} · ${medidas(d.ancho, d.alto)}`,
  url: `/bolsos/${bolso.id}`,
  orientativo: true,
};

const descripcion = `${d.nombre}: ${d.material.toLowerCase()}. ${medidas(d.ancho, d.alto)}. Bolso de ganchillo hecho a mano, pieza única.`;
---

<Layout titulo={`${d.nombre} — ${site.marca}`} descripcion={descripcion} imagen={og.src}>
  <article class="px-5 py-12 sm:px-8">
    <div class="mx-auto max-w-7xl">
      <a href="/#bolsos" class="-ml-1 inline-block px-1 py-2 text-[15px] text-ink-soft no-underline hover:text-ink">
        ← Bolsos
      </a>

      <div class="mt-8 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[1.15fr_1fr]">
        <div>
          {/* Todas las fotos se apilan: las que no se ven están a opacidad 0, no ocultas,
              para que el navegador las cargue y el cambio de foto sea instantáneo. */}
          <div class="relative aspect-[3/4] bg-panel" data-galeria>
            {
              galeria.map((foto, i) => (
                <Image
                  src={foto}
                  alt={
                    i === 0
                      ? `Bolso ${d.nombre}, visto de frente.`
                      : `Bolso ${d.nombre}, detalle ${i}.`
                  }
                  widths={[480, 768, 1100]}
                  sizes="(min-width: 1024px) 44rem, 100vw"
                  class:list={[
                    'absolute inset-0 h-full w-full object-contain transition-opacity duration-300',
                    i > 0 && 'opacity-0',
                  ]}
                  data-foto={i}
                  aria-hidden={i > 0 ? 'true' : undefined}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>

          {
            galeria.length > 1 && (
              <div class="mt-3 flex flex-wrap gap-3" role="group" aria-label="Fotos de la pieza">
                {galeria.map((foto, i) => (
                  <button type="button" class="miniatura" data-mini={i} aria-current={i === 0}>
                    <Image
                      src={foto}
                      alt={`Ver foto ${i + 1} de ${galeria.length}`}
                      widths={[120, 240]}
                      sizes="4.5rem"
                      class="aspect-[3/4] w-[4.5rem] object-cover"
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="lg:sticky lg:top-24">
          <h1 class="font-display text-[clamp(2.25rem,6vw,3.5rem)]">{d.nombre}</h1>

          <p class="mt-3 font-display text-2xl">
            {vendido ? 'Vendido' : precio(d.precio)}
          </p>

          <dl class="filete mt-8 grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 pt-6 text-[15px]">
            <dt class="text-ink-soft">Material</dt>
            <dd>{d.material}</dd>
            <dt class="text-ink-soft">Medidas</dt>
            <dd>{medidas(d.ancho, d.alto)}</dd>
            <dt class="text-ink-soft">Color</dt>
            <dd class="flex items-center gap-2.5">
              <span
                class="inline-block h-4 w-4 rounded-full"
                style={`background:${color.muestra};box-shadow:inset 0 0 0 1px rgb(31 29 27 / 0.18)`}
                aria-hidden="true"></span>
              {color.nombre}
            </dd>
          </dl>

          <div class="mt-8">
            {
              vendido ? (
                <>
                  <button
                    type="button"
                    class="boton w-full sm:w-auto"
                    data-anadir={JSON.stringify(lineaSimilar)}
                    data-etiqueta="Encargar uno similar"
                  >
                    Encargar uno similar
                  </button>
                  <p class="mt-3 max-w-[46ch] text-[15px] text-ink-soft">
                    Esta ya tiene dueña. Se queda aquí porque es parte del trabajo, y porque
                    se puede tejer otra parecida: nunca sale idéntica. Partiría de{' '}
                    {precio(d.precio)}, orientativo hasta que lo habléis.
                  </p>
                </>
              ) : (
                <>
                  <button type="button" class="boton w-full sm:w-auto" data-anadir={JSON.stringify(linea)}>
                    Añadir al pedido
                  </button>
                  <p class="mt-3 max-w-[46ch] text-[15px] text-ink-soft">
                    Es una pieza única y no se cobra nada aquí: reúnes lo que te guste y se lo
                    mandas escrito por WhatsApp. Sakina te confirma que sigue disponible.
                  </p>
                </>
              )
            }
          </div>

          <nav class="filete mt-10 flex justify-between gap-6 pt-6 text-[15px]" aria-label="Otras piezas">
            <a href={`/bolsos/${anterior.id}`} class="text-ink-soft no-underline hover:text-ink">
              ← {anterior.data.nombre}
            </a>
            <a href={`/bolsos/${siguiente.id}`} class="text-ink-soft no-underline hover:text-ink">
              {siguiente.data.nombre} →
            </a>
          </nav>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .miniatura img {
    outline: 1px solid var(--color-line);
    outline-offset: -1px;
    transition: outline-color 180ms var(--ease-salida);
  }
  .miniatura[aria-current='true'] img {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>

<script>
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const minis = [...document.querySelectorAll<HTMLButtonElement>('[data-mini]')];

  if (galeria && minis.length > 1) {
    const fotos = [...galeria.querySelectorAll<HTMLElement>('[data-foto]')];
    for (const mini of minis) {
      mini.addEventListener('click', () => {
        const i = mini.dataset.mini;
        for (const foto of fotos) {
          const activa = foto.dataset.foto === i;
          foto.classList.toggle('opacity-0', !activa);
          foto.toggleAttribute('aria-hidden', !activa);
        }
        for (const otra of minis) otra.setAttribute('aria-current', String(otra === mini));
      });
    }
  }
</script>
