---
import Menu from './Menu.astro';
import Simbolo from './Simbolo.astro';
---

<header
  class="sticky top-0 z-40 border-b border-transparent bg-paper/92 backdrop-blur-sm transition-colors duration-300 data-[sobre-manta]:border-transparent! data-[sobre-manta]:bg-transparent! data-[sobre-manta]:backdrop-blur-none"
  data-nav
>
  {/*
    Las rayitas y el logo van los dos fuera de esta barra, pegados entre sí, no dentro.
    La barra va centrada en una columna de 1280px igual que el resto de la web
    (`max-w-7xl mx-auto`): en una pantalla más ancha que eso le crece un margen
    automático a los lados, y con el logo dentro ese margen lo iba empujando hacia el
    centro de la pantalla cuanto más ancha era —las rayitas se quedaban pegadas al
    borde, pero el logo se alejaba de ellas—. `header` sí ocupa el ancho completo, así
    que los dos se anclan a él y quedan pegados el uno al otro en cualquier tamaño; solo
    el botón de la derecha sigue la columna centrada, para alinearse con el resto del
    contenido de la página.
  */}
  <Menu />

  <a href="/" class="logo no-underline">
    <Simbolo alt="Sakina Platero" class="w-9 sm:w-10" sizes="2.5rem" cargaDiferida={false} />
  </a>

  <nav class="mx-auto flex max-w-7xl items-center py-4 pr-5 sm:pr-8" aria-label="Principal">
    <button
      type="button"
      class="ml-auto flex items-center gap-2 text-[15px]"
      data-abrir-carrito
      aria-haspopup="dialog"
    >
      <span>Pedido</span>
      <span
        class="grid h-6 min-w-6 place-items-center rounded-full bg-deep px-1.5 text-[13px] leading-none text-paper"
        data-cuenta-carrito
        aria-hidden="true"
        hidden>0</span
      >
      <span class="sr-only" data-cuenta-texto>vacío</span>
    </button>
  </nav>
</header>

<style>
  /*
   * Pegado al botón de las rayitas (que termina en 53px: empieza en 9, mide 44), con el
   * mismo aire de 3px que hay entre las rayas y su propio borde. Ancla al `header`, no
   * a la barra centrada, para que la distancia a las rayitas sea la misma sin importar
   * lo ancha que sea la pantalla.
   */
  .logo {
    position: absolute;
    left: 56px;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  if (nav) {
    /*
     * Mientras la portada enseña su fondo de manta, la barra se quita el papel: una
     * franja clara cruzando por encima se leía como un error, no como una barra.
     * Se mide la posición de la escena en vez de contar píxeles, así que si algún día
     * cambia lo que dura el desfile esto no se entera.
     */
    const escena = document.querySelector('[data-escena]');
    const marcar = () => {
      nav.classList.toggle('border-line', window.scrollY > 8);
      const sobreManta =
        !!escena && escena.getBoundingClientRect().bottom > window.innerHeight;
      nav.toggleAttribute('data-sobre-manta', sobreManta);
    };
    marcar();
    window.addEventListener('scroll', marcar, { passive: true });
    window.addEventListener('resize', marcar);
  }
</script>
