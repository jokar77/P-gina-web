---
/**
 * Galería de una ficha: foto grande y miniaturas en columna a su izquierda.
 *
 * La usan las dos fichas, la de bolsos y la de conjuntos. Estaba escrita solo en la de
 * bolsos y la de niño apilaba las fotos una debajo de otra; copiarla habría dejado dos
 * versiones que se separan a la primera corrección.
 *
 * En pantalla estrecha las miniaturas bajan debajo: una columna al lado se come un octavo
 * del ancho, y en un móvil eso se lo quita a lo único que importa mirar.
 *
 * La foto grande se puede ampliar de dos formas. Con ratón, pasarlo por encima saca una
 * lupa que sigue el puntero y muestra esa zona ampliada, como una lupa de verdad sobre
 * el papel. En pantalla táctil no hay puntero que seguir, así que ahí (y si se prefiere,
 * también con ratón) pulsar la foto o el icono abre la misma foto a pantalla completa,
 * con las mismas flechas para seguir pasando fotos sin cerrarla.
 */
import { Image } from 'astro:assets';

interface Props {
  fotos: ImageMetadata[];
  /** Para el texto alternativo: «Bolso Marea, visto de frente». */
  nombre: string;
  /** Lo que es la pieza: «Bolso», «Conjunto». */
  tipo: string;
  /** Alto de la caja. Los bolsos van en 3:4; el lino, más alargado. */
  proporcion?: string;
}

const { fotos, nombre, tipo, proporcion = '3/4' } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row">
  {/* Todas las fotos se apilan: las que no se ven están a opacidad 0, no ocultas, para
      que el navegador las cargue y el cambio de foto sea instantáneo. */}
  <div class="relative flex-1 bg-panel" style={`aspect-ratio:${proporcion}`} data-galeria>
    {
      fotos.map((foto, i) => (
        <Image
          src={foto}
          alt={i === 0 ? `${tipo} ${nombre}, visto de frente.` : `${tipo} ${nombre}, detalle ${i}.`}
          widths={[480, 768, 1100]}
          sizes="(min-width: 1024px) 44rem, 100vw"
          class:list={[
            'foto-zoom absolute inset-0 h-full w-full object-contain transition-opacity duration-300',
            i > 0 && 'pointer-events-none opacity-0',
          ]}
          data-foto={i}
          aria-hidden={i > 0 ? 'true' : undefined}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))
    }
    {
      fotos.length > 1 && (
        <>
          <button type="button" class="flecha izquierda" data-flecha="-1" aria-label="Foto anterior">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 4 7 12l8 8" />
            </svg>
          </button>
          <button type="button" class="flecha derecha" data-flecha="1" aria-label="Foto siguiente">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 4 8 8-8 8" />
            </svg>
          </button>
        </>
      )
    }
    <button type="button" class="flecha zoom-abrir" data-zoom-abrir aria-label="Ampliar foto">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M20 20 15.7 15.7" />
        <path d="M10.5 8v5M8 10.5h5" />
      </svg>
    </button>
    {/* Solo se activa con ratón (ver el script): en táctil se queda oculta y de por
        medio. */}
    <div class="lente" data-lente hidden aria-hidden="true" />
  </div>

  {
    fotos.length > 1 && (
      <div
        class="flex flex-wrap gap-3 sm:order-first sm:w-[4.5rem] sm:shrink-0 sm:flex-col sm:flex-nowrap"
        role="group"
        aria-label="Fotos de la pieza"
      >
        {fotos.map((foto, i) => (
          <button type="button" class="miniatura" data-mini={i} aria-current={i === 0}>
            <Image
              src={foto}
              alt={`Ver foto ${i + 1} de ${fotos.length}`}
              widths={[120, 240]}
              sizes="4.5rem"
              class="aspect-[3/4] w-[4.5rem] object-cover"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<dialog class="zoom oscuro m-0 h-dvh max-h-none w-full max-w-none border-0 p-0" data-zoom aria-label={`${tipo} ${nombre} ampliado`}>
  <div class="relative flex h-full w-full items-center justify-center p-4" data-zoom-fondo>
    {
      fotos.map((foto, i) => (
        <Image
          src={foto}
          alt={i === 0 ? `${tipo} ${nombre}, visto de frente.` : `${tipo} ${nombre}, detalle ${i}.`}
          widths={[768, 1100, 1600]}
          sizes="100vw"
          class:list={[
            'absolute inset-0 m-auto h-auto w-auto max-h-full max-w-full object-contain transition-opacity duration-200',
            i > 0 && 'pointer-events-none opacity-0',
          ]}
          data-foto-zoom={i}
          loading="lazy"
        />
      ))
    }
    <button type="button" class="cerrar-zoom" data-zoom-cerrar aria-label="Cerrar foto ampliada">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
    {
      fotos.length > 1 && (
        <>
          <button type="button" class="flecha izquierda" data-flecha-zoom="-1" aria-label="Foto anterior">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 4 7 12l8 8" />
            </svg>
          </button>
          <button type="button" class="flecha derecha" data-flecha-zoom="1" aria-label="Foto siguiente">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 4 8 8-8 8" />
            </svg>
          </button>
        </>
      )
    }
  </div>
</dialog>

<style>
  .flecha {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: var(--color-ink);
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      0 2px 10px rgb(31 29 27 / 0.14);
    backdrop-filter: blur(6px);
    transition: background-color 220ms var(--ease-salida);
  }
  .flecha:hover {
    background-color: var(--color-paper);
  }
  .izquierda {
    left: 10px;
  }
  .derecha {
    right: 10px;
  }
  .zoom-abrir {
    top: auto;
    right: 10px;
    bottom: 10px;
    transform: none;
  }

  .foto-zoom {
    cursor: zoom-in;
  }

  .lente {
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 9999px;
    pointer-events: none;
    background-repeat: no-repeat;
    box-shadow:
      0 0 0 4px var(--color-paper),
      inset 0 0 0 1px rgb(31 29 27 / 0.25),
      0 6px 20px rgb(31 29 27 / 0.35);
    z-index: 10;
  }
  /* Con el puntero encima, el cursor del sistema estorba junto a la lupa. La foto
     tiene su propio cursor (zoom-in) que si no, ganaría por ser más específico. */
  [data-galeria].con-lente,
  [data-galeria].con-lente .foto-zoom {
    cursor: none;
  }

  dialog.zoom {
    border: 0;
  }
  dialog.zoom::backdrop {
    background-color: var(--color-deep);
  }
  .cerrar-zoom {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    color: var(--color-paper);
    background-color: color-mix(in srgb, var(--color-paper) 12%, transparent);
    transition: background-color 220ms var(--ease-salida);
  }
  .cerrar-zoom:hover {
    background-color: color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .miniatura img {
    outline: 1px solid var(--color-line);
    outline-offset: -1px;
    transition: outline-color 180ms var(--ease-salida);
  }
  .miniatura[aria-current='true'] img {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>

<script>
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const minis = [...document.querySelectorAll<HTMLButtonElement>('[data-mini]')];
  const zoom = document.querySelector<HTMLDialogElement>('[data-zoom]');
  const lente = document.querySelector<HTMLElement>('[data-lente]');

  if (galeria) {
    const fotos = [...galeria.querySelectorAll<HTMLImageElement>('[data-foto]')];
    const flechas = [...galeria.querySelectorAll<HTMLButtonElement>('[data-flecha]')];
    const fotosZoom = zoom ? [...zoom.querySelectorAll<HTMLElement>('[data-foto-zoom]')] : [];
    const flechasZoom = zoom ? [...zoom.querySelectorAll<HTMLButtonElement>('[data-flecha-zoom]')] : [];

    const actual = () => fotos.findIndex((foto) => !foto.classList.contains('opacity-0'));

    const fotoActivaParaLente = () => fotos[actual()];

    const activar = (i: number) => {
      for (const foto of fotos) {
        const activa = Number(foto.dataset.foto) === i;
        foto.classList.toggle('opacity-0', !activa);
        foto.classList.toggle('pointer-events-none', !activa);
        foto.toggleAttribute('aria-hidden', !activa);
      }
      for (const foto of fotosZoom) {
        const activa = Number(foto.dataset.fotoZoom) === i;
        foto.classList.toggle('opacity-0', !activa);
        foto.classList.toggle('pointer-events-none', !activa);
      }
      for (const mini of minis) mini.setAttribute('aria-current', String(Number(mini.dataset.mini) === i));
      if (lente && !lente.hidden) {
        const foto = fotoActivaParaLente();
        if (foto) lente.style.backgroundImage = `url(${foto.currentSrc || foto.src})`;
      }
    };

    for (const mini of minis) {
      mini.addEventListener('click', () => activar(Number(mini.dataset.mini)));
    }

    for (const flecha of flechas) {
      flecha.addEventListener('click', () => {
        activar((actual() + Number(flecha.dataset.flecha) + fotos.length) % fotos.length);
      });
    }

    for (const flecha of flechasZoom) {
      flecha.addEventListener('click', () => {
        activar((actual() + Number(flecha.dataset.flechaZoom) + fotos.length) % fotos.length);
      });
    }

    if (zoom) {
      const abrir = () => zoom.showModal();
      for (const foto of fotos) foto.addEventListener('click', abrir);
      galeria.querySelector('[data-zoom-abrir]')?.addEventListener('click', abrir);
      zoom.querySelector('[data-zoom-cerrar]')?.addEventListener('click', () => zoom.close());
      // El fondo alrededor de la foto también cierra al pulsarlo. La foto llena la caja
      // con object-contain, así que casi siempre queda margen visible donde pulsar.
      const fondo = zoom.querySelector('[data-zoom-fondo]');
      zoom.addEventListener('click', (e) => {
        if (e.target === zoom || e.target === fondo) zoom.close();
      });
    }

    /*
     * La lupa de verdad: solo con ratón (o lápiz), nunca en táctil, donde no hay
     * puntero que la mueva y taparía la foto con el dedo encima. Se activa aunque el
     * dispositivo también tenga pantalla táctil, mientras el puntero usado sea fino.
     */
    if (lente && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const AUMENTO = 2.4;

      galeria.addEventListener('mouseenter', () => {
        const foto = fotoActivaParaLente();
        if (!foto) return;
        lente.style.backgroundImage = `url(${foto.currentSrc || foto.src})`;
        lente.hidden = false;
        galeria.classList.add('con-lente');
      });

      galeria.addEventListener('mouseleave', () => {
        lente.hidden = true;
        galeria.classList.remove('con-lente');
      });

      galeria.addEventListener('mousemove', (e) => {
        const caja = galeria.getBoundingClientRect();
        const x = e.clientX - caja.left;
        const y = e.clientY - caja.top;
        const lado = lente.offsetWidth;

        // La lupa se queda dentro de la caja aunque el puntero ande cerca del borde.
        const cx = Math.min(Math.max(x, lado / 2), caja.width - lado / 2);
        const cy = Math.min(Math.max(y, lado / 2), caja.height - lado / 2);
        lente.style.left = `${cx - lado / 2}px`;
        lente.style.top = `${cy - lado / 2}px`;

        lente.style.backgroundSize = `${caja.width * AUMENTO}px ${caja.height * AUMENTO}px`;
        lente.style.backgroundPosition = `${-(x * AUMENTO - lado / 2)}px ${-(y * AUMENTO - lado / 2)}px`;
      });
    }
  }
</script>
