---
import { Image } from 'astro:assets';
import config from '../data/configurador.json';
import { COLORES, type ColorId } from '../data/colores';
import site from '../data/site.json';
import tote from '../assets/piezas/mimosa/01.jpg';
import hombro from '../assets/piezas/lazada/01.jpg';
import sinAsa from '../assets/piezas/duna/01.jpg';

// Cada forma se enseña con una pieza real ya hecha, no con un dibujo.
const fotos: Record<string, ImageMetadata> = { tote, hombro, 'sin-asa': sinAsa };
const colores = Object.entries(COLORES) as [ColorId, (typeof COLORES)[ColorId]][];
const seccion = site.secciones.disena;
---

<section id="disena" class="oscuro scroll-mt-20 px-5 py-section sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)]">{seccion.titulo}</h2>
      <p class="max-w-[52ch] text-paper/70">{seccion.intro}</p>
    </div>

    <form class="mt-12 grid gap-x-12 gap-y-10 lg:grid-cols-[1fr_20rem]" data-configurador>
      <div class="grid gap-10">
        <fieldset>
          <legend class="font-display text-2xl">La forma</legend>
          <div class="mt-5 grid grid-cols-3 gap-4">
            {
              config.formas.map((f, i) => (
                <label class="opcion-forma">
                  <input type="radio" name="forma" value={f.id} checked={i === 0} class="sr-only" />
                  <Image
                    src={fotos[f.id]!}
                    alt=""
                    widths={[200, 400]}
                    sizes="(min-width: 640px) 14rem, 30vw"
                    class="aspect-[3/4] w-full object-cover"
                    loading="lazy"
                  />
                  <span class="mt-2.5 block text-[15px]">{f.nombre}</span>
                  <span class="block text-[15px] text-paper/60">{f.precio} €</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="font-display text-2xl">El color</legend>
          <div class="mt-5 flex flex-wrap gap-2.5">
            {
              colores.map(([id, c], i) => (
                <label class="opcion-color" title={c.nombre}>
                  <input type="radio" name="color" value={id} checked={i === 0} class="sr-only" />
                  <span class="punto" style={`--muestra:${c.muestra}`} aria-hidden="true" />
                  <span class="sr-only">{c.nombre}</span>
                </label>
              ))
            }
          </div>
          <p class="mt-3 text-[15px] text-paper/60" data-color-elegido></p>
        </fieldset>

        <fieldset>
          <legend class="font-display text-2xl">Los detalles</legend>
          <div class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {
              config.extras.map((e) => (
                <label class="flex cursor-pointer items-center gap-3">
                  <input type="checkbox" name="extra" value={e.id} data-precio={e.precio} class="sr-only" />
                  <span class="casilla" aria-hidden="true" />
                  <span class="flex-1">{e.nombre}</span>
                  <span class="text-paper/60">+{e.precio} €</span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <canvas class="hilo mx-auto block" data-hilo width="220" height="220" aria-hidden="true"></canvas>
        <div class="border-t border-paper/25 pt-6">
          <p class="text-[15px] text-paper/70">Tu bolso</p>
          <p class="mt-2 font-display text-2xl" data-resumen-forma></p>
          <p class="mt-1 text-paper/70" data-resumen-detalles></p>

          <div class="mt-7 flex items-baseline justify-between gap-4 border-t border-paper/25 pt-5">
            <span class="text-[15px] text-paper/70">Precio orientativo</span>
            <span class="font-display text-3xl" data-resumen-total></span>
          </div>

          <button type="button" class="boton boton-claro mt-6 w-full" data-anadir-medida>
            Añadir al pedido
          </button>
          <p class="mt-3 text-[14px] text-paper/60">
            {site.fichas.aMedida}
          </p>
        </div>
      </aside>
    </form>
  </div>
</section>

<style>
  .hilo {
    width: 220px;
    height: 220px;
    max-width: 100%;
  }

  .opcion-forma {
    cursor: pointer;
    display: block;
  }
  .opcion-forma img {
    outline: 2px solid transparent;
    outline-offset: 4px;
    transition: outline-color 200ms var(--ease-salida);
  }
  .opcion-forma:has(input:checked) img {
    outline-color: var(--color-paper);
  }
  .opcion-forma:has(input:focus-visible) img {
    outline-color: var(--color-paper);
    outline-style: dashed;
  }

  .opcion-color {
    cursor: pointer;
  }
  .punto {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgb(230 232 229 / 0.25);
    transition:
      transform 200ms var(--ease-salida),
      box-shadow 200ms var(--ease-salida);
  }
  @media (hover: hover) and (pointer: fine) {
    .opcion-color:hover .punto {
      transform: scale(1.1);
    }
  }
  .opcion-color:has(input:checked) .punto {
    box-shadow:
      inset 0 0 0 1px rgb(230 232 229 / 0.25),
      0 0 0 2px var(--color-deep),
      0 0 0 3.5px var(--color-paper);
  }
  .opcion-color:has(input:focus-visible) .punto {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }

  .casilla {
    width: 20px;
    height: 20px;
    flex: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 45%, transparent);
    transition: background-color 180ms var(--ease-salida);
  }
  input:checked + .casilla {
    background-color: var(--color-paper);
    box-shadow:
      inset 0 0 0 1px var(--color-paper),
      inset 0 0 0 5px var(--color-deep),
      inset 0 0 0 20px var(--color-paper);
  }
  input:focus-visible + .casilla {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }
</style>

<script>
  import config from '../data/configurador.json';
  import { COLORES, type ColorId } from '../data/colores';
  import { anadir } from '../lib/carrito';
  import { precio } from '../lib/formato';

  /**
   * El nudo de hilo del panel «Tu bolso»: un torus knot en three.js, cargado aparte
   * (import dinámico) para no meter la librería en el resto de la web. Gira solo y
   * toma el color que se vaya eligiendo; es decorativo, así que cualquier fallo —sin
   * WebGL, sin soporte— se traga y el configurador sigue funcionando sin él.
   */
  function iniciarHilo(): Promise<((hex: string) => void) | null> {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hilo]');
    if (!canvas) return Promise.resolve(null);

    // Three.js pesa lo suyo para algo puramente decorativo: no se pide hasta que el
    // panel esté a punto de entrar en pantalla, para no cargarlo en quien no llega
    // a bajar hasta «Diseña tu bolso».
    return new Promise((resolver) => {
      const obs = new IntersectionObserver(
        ([entrada]) => {
          if (!entrada.isIntersecting) return;
          obs.disconnect();
          cargar(canvas).then(resolver);
        },
        { rootMargin: '200px' }
      );
      obs.observe(canvas);
    });
  }

  async function cargar(canvas: HTMLCanvasElement) {
    try {
      const THREE = await import('three');
      const LADO = 220;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(LADO, LADO, false);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 10);
      camera.position.set(0, 0, 4.2);

      scene.add(new THREE.AmbientLight(0xffffff, 0.6));
      const sol = new THREE.DirectionalLight(0xffffff, 1.3);
      sol.position.set(2, 3, 4);
      scene.add(sol);

      const geometria = new THREE.TorusKnotGeometry(0.85, 0.26, 140, 16, 2, 3);
      const material = new THREE.MeshStandardMaterial({ roughness: 0.55, metalness: 0.05 });
      const nudo = new THREE.Mesh(geometria, material);
      scene.add(nudo);

      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Solo gira mientras se ve: fuera de pantalla no hay razón para gastar el
      // fotograma, y respeta «menos animación» igual que el resto de la web.
      let visible = true;
      new IntersectionObserver(([entrada]) => (visible = entrada.isIntersecting), {
        threshold: 0.05,
      }).observe(canvas);

      const paso = () => {
        if (visible && !document.hidden) {
          nudo.rotation.x += 0.0035;
          nudo.rotation.y += 0.0055;
          renderer.render(scene, camera);
        }
        if (!reducido) requestAnimationFrame(paso);
      };

      if (reducido) renderer.render(scene, camera);
      else paso();

      return (hex: string) => material.color.set(hex);
    } catch {
      canvas.hidden = true;
      return null;
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-configurador]');

  if (form) {
    const resumenForma = form.querySelector<HTMLElement>('[data-resumen-forma]')!;
    const resumenDetalles = form.querySelector<HTMLElement>('[data-resumen-detalles]')!;
    const resumenTotal = form.querySelector<HTMLElement>('[data-resumen-total]')!;
    const colorElegido = form.querySelector<HTMLElement>('[data-color-elegido]')!;
    const boton = form.querySelector<HTMLButtonElement>('[data-anadir-medida]')!;

    const estado = () => {
      const datos = new FormData(form);
      const forma = config.formas.find((f) => f.id === datos.get('forma'))!;
      const colorId = datos.get('color') as ColorId;
      const extras = config.extras.filter((e) => datos.getAll('extra').includes(e.id));
      const total = forma.precio + extras.reduce((s, e) => s + e.precio, 0);
      return { forma, color: COLORES[colorId], extras, total };
    };

    // El bicolor no tiene un único hex: es un degradado CSS. Para el nudo de hilo se
    // coge el primer tono, que basta para que el color se note sin dibujar dos mitades.
    const primerColorHex = (muestra: string) => muestra.match(/#[0-9a-f]{3,8}/i)?.[0] ?? '#B6B2AE';

    let fijarColorHilo: ((hex: string) => void) | null = null;

    const pintar = () => {
      const { forma, color, extras, total } = estado();
      resumenForma.textContent = `${forma.nombre}, ${color.nombre.toLowerCase()}`;
      resumenDetalles.textContent = extras.length
        ? extras.map((e) => e.nombre.toLowerCase()).join(', ')
        : 'Sin detalles añadidos';
      resumenTotal.textContent = precio(total);
      colorElegido.textContent = color.nombre;
      fijarColorHilo?.(primerColorHex(color.muestra));
    };

    form.addEventListener('change', pintar);
    pintar();

    iniciarHilo().then((fijar) => {
      fijarColorHilo = fijar;
      fijarColorHilo?.(primerColorHex(estado().color.muestra));
    });

    boton.addEventListener('click', () => {
      const { forma, color, extras, total } = estado();
      const detalle = [
        color.nombre.toLowerCase(),
        ...extras.map((e) => e.nombre.toLowerCase()),
      ].join(', ');

      anadir({
        id: `medida-${Date.now()}`,
        nombre: `${forma.nombre} a medida`,
        precio: total,
        detalle,
        orientativo: true,
      });

      document.querySelector<HTMLDialogElement>('[data-carrito]')?.showModal();
    });
  }
</script>
