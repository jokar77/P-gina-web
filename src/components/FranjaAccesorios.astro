---
/**
 * La franja de accesorios de la portada: una fila de piezas pequeñas que se pasa de
 * lado, justo después de las puertas. Son cosas de comprar «de paso» —tarjeteros,
 * monederos—, así que se enseñan ya con su precio y llevan directo a su ficha, sin
 * tener que entrar antes a ninguna sección. «Ver todos» lleva a /accesorios.
 *
 * Mientras no haya ningún accesorio, la franja no sale.
 *
 * Se pasa arrastrando, con el dedo o con el ratón. Con ratón, además, hay dos flechas: una fila que
 * solo se mueve con la rueda en horizontal (que casi nadie tiene) es una fila que no
 * se mueve.
 *
 * Y se mueve sola: la fila corre despacio y sin fin hacia la izquierda (al llegar al
 * final enlaza con el principio, sin saltos) y cada pieza flota arriba y abajo a su
 * ritmo, como expuesta. Se para mientras alguien la toca, pasa el ratón por encima o
 * tiene el foco dentro, mientras no se ve en pantalla, y nunca con «reducir
 * movimiento».
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import site from '../data/site.json';
import { precio } from '../lib/formato';
import { porOrdenConVendidosAlFinal } from '../lib/accesorios';

const accesorios = porOrdenConVendidosAlFinal(await getCollection('accesorios'));
const seccion = site.secciones.accesorios;

const etiqueta = (estado: string, euros: number) =>
  estado === 'vendido' ? 'Vendido' : estado === 'encargo' ? `Desde ${precio(euros)}` : precio(euros);
---

{
  accesorios.length > 0 && (
    <section class="franja px-5 py-section sm:px-8" aria-labelledby="franja-accesorios">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <h2 id="franja-accesorios" class="font-display text-[clamp(2rem,5vw,3.25rem)]">
            {seccion.titulo}
          </h2>
          <div class="flex items-center gap-3">
            <button type="button" class="flecha" data-franja-mover="-1" aria-label="Anteriores">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button type="button" class="flecha" data-franja-mover="1" aria-label="Siguientes">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
            <a href="/accesorios" class="ml-2 text-[15px] underline underline-offset-[0.28em]">
              Ver todos
            </a>
          </div>
        </div>

        <ul class="fila" data-franja>
          {accesorios.map((a, i) => (
            <li class="pieza" style={`--i:${i}`}>
              <a href={`/accesorios/${a.id}`} class="group block no-underline">
                <div class="relative overflow-hidden rounded-[var(--radio-foto)] bg-paper">
                  <Image
                    src={a.data.foto}
                    alt={`${a.data.nombre}: ${a.data.material.toLowerCase()}.`}
                    widths={[240, 400, 560]}
                    sizes="(min-width: 1024px) 15rem, 42vw"
                    class="aspect-[3/4] w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
                    loading={i < 4 ? 'eager' : 'lazy'}
                  />
                  {a.data.tresPorDos && a.data.estado !== 'vendido' && (
                    <span class="etiqueta-oferta absolute top-2.5 left-2.5">3x2</span>
                  )}
                </div>
                <div class="mt-3 flex items-baseline justify-between gap-3">
                  <h3 class="font-display text-lg leading-tight">{a.data.nombre}</h3>
                  <span
                    class:list={[
                      'shrink-0 text-[15px]',
                      a.data.estado === 'vendido' && 'text-ink-soft',
                    ]}
                  >
                    {etiqueta(a.data.estado, a.data.precio)}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .fila {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(42vw, 15rem);
    gap: 1.25rem;
    margin: 1.25rem -1.25rem 0;
    padding: 0.75rem 1.25rem 0.9rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 1.25rem;
    scrollbar-width: none;
    list-style: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .fila {
      cursor: grab;
    }
  }
  .fila.arrastrando {
    cursor: grabbing;
    user-select: none;
  }
  .fila::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 640px) {
    .fila {
      gap: 1.75rem;
      margin-inline: -2rem;
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }
  }
  /* Cada pieza flota arriba y abajo, con su propio desfase para que no vayan a la par. */
  .pieza > a > div {
    animation: flotar 4.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.9s);
  }
  @keyframes flotar {
    from {
      transform: translateY(5px) rotate(-0.8deg);
    }
    to {
      transform: translateY(-7px) rotate(0.8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pieza > a > div {
      animation: none;
    }
  }

  /* Las flechas solo tienen sentido con ratón: con el dedo la fila ya se arrastra. */
  .flecha {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: background-color 200ms var(--ease-salida), opacity 200ms;
  }
  .flecha svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flecha:hover {
    background-color: color-mix(in srgb, var(--color-line) 28%, transparent);
  }
  .flecha:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (hover: hover) and (pointer: fine) {
    .flecha {
      display: grid;
    }
  }
</style>

<script>
  const fila = document.querySelector<HTMLElement>('[data-franja]');
  const flechas = [...document.querySelectorAll<HTMLButtonElement>('[data-franja-mover]')];

  if (fila) {
    // Cada flecha avanza casi una pantalla de fila: se ve lo nuevo sin perder el hilo.
    for (const f of flechas) {
      f.addEventListener('click', () => {
        const sentido = Number(f.dataset.franjaMover);
        fila.scrollBy({ left: sentido * fila.clientWidth * 0.85, behavior: 'smooth' });
      });
    }
    // Una flecha que no lleva a ningún sitio se apaga; si cabe todo, se apagan las dos.
    const actualizar = () => {
      const max = fila.scrollWidth - fila.clientWidth - 2;
      flechas[0]!.disabled = fila.scrollLeft <= 2;
      flechas[1]!.disabled = fila.scrollLeft >= max;
    };
    fila.addEventListener('scroll', actualizar, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();

    /*
     * Con el dedo la fila ya se arrastra sola (es un scroll de verdad). Con ratón se
     * arrastra a mano: se mueve con el puntero y, si de verdad se ha arrastrado, el
     * clic de al soltar no abre la pieza.
     */
    let arrastre: { x: number; left: number; movido: boolean } | null = null;
    fila.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      arrastre = { x: e.clientX, left: fila.scrollLeft, movido: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!arrastre) return;
      const dx = e.clientX - arrastre.x;
      if (Math.abs(dx) > 5) arrastre.movido = true;
      if (arrastre.movido) {
        fila.scrollLeft = arrastre.left - dx;
        fila.classList.add('arrastrando');
      }
    });
    window.addEventListener('pointerup', () => {
      if (arrastre?.movido) {
        fila.addEventListener('click', (e) => (e.preventDefault(), e.stopPropagation()), {
          capture: true,
          once: true,
        });
      }
      arrastre = null;
      fila.classList.remove('arrastrando');
    });
    // Que el navegador no arrastre la foto o el enlace como si fuera un archivo.
    fila.addEventListener('dragstart', (e) => e.preventDefault());

    /*
     * Movimiento continuo. Se clonan las piezas detrás de las de verdad (ocultas para
     * lectores de pantalla y teclado) y, cuando la fila ha corrido el ancho de una
     * vuelta, se resta ese ancho: así parece una cinta sin fin, sin volver atrás.
     */
    const VELOCIDAD = 28; // píxeles por segundo
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');
    const originales = [...fila.children] as HTMLElement[];
    const caben = () => fila.scrollWidth <= fila.clientWidth + 2;

    if (!caben() && !quieto.matches) {
      for (const li of originales) {
        const copia = li.cloneNode(true) as HTMLElement;
        copia.setAttribute('aria-hidden', 'true');
        copia.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
        fila.append(copia);
      }
      const vuelta = () => (fila.children[originales.length] as HTMLElement).offsetLeft - originales[0]!.offsetLeft;

      let tocando = false;
      let encima = false;
      let enPantalla = false;
      let quietaHasta = 0;
      let pos = fila.scrollLeft;
      let antes = 0;

      const paso = (t: number) => {
        const dt = antes ? Math.min(t - antes, 64) / 1000 : 0;
        antes = t;
        const libre =
          !tocando && !encima && enPantalla && !document.hidden && Date.now() >= quietaHasta;
        if (libre) {
          pos += VELOCIDAD * dt;
          const v = vuelta();
          if (pos >= v) pos -= v;
          fila.scrollLeft = pos;
        } else {
          pos = fila.scrollLeft;
        }
        requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);

      // Tras moverla a mano, espera un poco antes de seguir sola.
      const esperar = () => (quietaHasta = Date.now() + 2500);
      fila.addEventListener('pointerdown', () => ((tocando = true), esperar()));
      // Si el navegador se queda el gesto para hacer scroll, avisa con pointercancel.
      const soltar = () => ((tocando = false), esperar());
      window.addEventListener('pointerup', soltar);
      window.addEventListener('pointercancel', soltar);
      // Un scroll que no viene de la cinta (el impulso tras soltar el dedo) también espera.
      fila.addEventListener('scroll', () => Math.abs(fila.scrollLeft - pos) > 2 && esperar(), {
        passive: true,
      });
      fila.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && (encima = true));
      fila.addEventListener('pointerleave', () => (encima = false));
      fila.addEventListener('focusin', () => (encima = true));
      fila.addEventListener('focusout', () => (encima = false));
      fila.addEventListener('wheel', esperar, { passive: true });
      for (const f of flechas) f.addEventListener('click', esperar);
      new IntersectionObserver(([e]) => (enPantalla = !!e?.isIntersecting), { threshold: 0.3 }).observe(
        fila,
      );
    }
  }
</script>
