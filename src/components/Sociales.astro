---
/**
 * El apartado de redes: una ventana por red, con una foto o un vídeo al azar que cambia
 * en cada visita.
 *
 * No lee las redes en directo. Un feed de verdad pediría la API oficial de cada
 * plataforma —cuenta de empresa, aprobación de la app, un token que caduca y hay que ir
 * renovando—, que es mantenimiento continuo y no encaja con una web estática sin
 * servidor que lleva una sola persona sin conocimientos técnicos. En su lugar, Sakina
 * sube un puñado de fotos y vídeos por red desde Pages CMS —lo mismo que ya hace con las
 * fotos de pieza— y aquí se elige uno al azar de entre los dos tipos mezclados.
 *
 * Cada foto y cada vídeo puede llevar su propio enlace a esa publicación exacta, para
 * que al pulsar se vaya justo ahí y no al perfil general. Es opcional: si Sakina no lo
 * rellena, se usa el enlace del perfil (site.json) como respaldo, así que subir una
 * captura sin buscar su URL exacta no rompe nada, solo lleva a un sitio menos preciso.
 *
 * Una ventana solo aparece si tiene las dos cosas: el enlace del perfil relleno en
 * «Textos y datos de la web» (para el respaldo, y para el icono) y al menos un medio
 * (foto o vídeo) subido. Si falta cualquiera de las dos, esa ventana no sale, igual que
 * un icono del pie sin enlace no aparece (ver Redes.astro). Y si no queda ninguna
 * ventana, la sección entera desaparece, como «Otros trabajos» cuando está vacío (ver
 * Archivo.astro).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { opcional } from '../lib/ajustes';

const entrada = (await getCollection('redes'))[0];

type Medio =
  | { tipo: 'foto'; valor: ImageMetadata; enlace?: string }
  | { tipo: 'video'; valor: string; enlace?: string };

const mezclar = (
  fotos: { foto: ImageMetadata; enlace?: string }[],
  videos: { video: string; enlace?: string }[]
): Medio[] => [
  ...fotos.map((f): Medio => ({ tipo: 'foto', valor: f.foto, enlace: f.enlace })),
  ...videos.map((v): Medio => ({ tipo: 'video', valor: v.video, enlace: v.enlace })),
];

const plataformas = [
  {
    id: 'instagram',
    nombre: 'Instagram',
    href: opcional('instagram'),
    medios: mezclar(entrada?.data.instagram ?? [], entrada?.data.instagramVideos ?? []),
  },
  {
    id: 'tiktok',
    nombre: 'TikTok',
    href: opcional('tiktok'),
    medios: mezclar(entrada?.data.tiktok ?? [], entrada?.data.tiktokVideos ?? []),
  },
  {
    id: 'youtube',
    nombre: 'YouTube',
    href: opcional('youtube'),
    medios: mezclar(entrada?.data.youtube ?? [], entrada?.data.youtubeVideos ?? []),
  },
].filter((p) => p.href && p.medios.length > 0);
---

{
  plataformas.length > 0 && (
    <section id="redes" class="scroll-mt-20 px-5 py-section sm:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
          <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)]">Redes</h2>
          <p class="max-w-[52ch] text-ink-soft">
            Un vistazo a lo último. Cada visita enseña una publicación distinta.
          </p>
        </div>

        <ul class="mt-10 grid grid-cols-1 gap-7 sm:grid-cols-3">
          {plataformas.map((p) => (
            <li>
              <a
                href={p.medios[0]!.enlace || p.href}
                class="group block no-underline"
                rel="me noopener"
                target="_blank"
                aria-label={`Ver publicación de ${p.nombre}`}
                data-enlace-respaldo={p.href}
              >
                <div class="ventana relative overflow-hidden bg-paper" data-capturas>
                  {p.medios.map((m, i) =>
                    m.tipo === 'foto' ? (
                      <Image
                        src={m.valor}
                        alt={`Publicación de ${p.nombre}.`}
                        widths={[320, 480, 640]}
                        sizes="(min-width: 640px) 22rem, 90vw"
                        class="captura absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
                        data-captura={i}
                        data-enlace={m.enlace || ''}
                        hidden={i !== 0}
                        loading="lazy"
                      />
                    ) : (
                      <video
                        src={m.valor}
                        class="captura absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
                        data-captura={i}
                        data-enlace={m.enlace || ''}
                        hidden={i !== 0}
                        muted
                        loop
                        playsinline
                        preload="none"
                        aria-label={`Vídeo de ${p.nombre}.`}
                      />
                    )
                  )}
                </div>
                <span class="etiqueta mt-3 flex items-center gap-2 text-[15px]">
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
                    {p.id === 'instagram' && (
                      <>
                        <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="5" />
                        <circle cx="12" cy="12" r="4.1" />
                        <circle cx="17.2" cy="6.8" r="1.15" class="relleno" />
                      </>
                    )}
                    {p.id === 'tiktok' && (
                      <path d="M13.6 3.2v10.9a3.1 3.1 0 1 1-2.6-3.06M13.6 6.1a4.7 4.7 0 0 0 4.4 3.1" />
                    )}
                    {p.id === 'youtube' && (
                      <>
                        <rect x="2.6" y="5.6" width="18.8" height="12.8" rx="4" />
                        <path d="M10.4 9.4 15 12l-4.6 2.6V9.4Z" class="relleno" />
                      </>
                    )}
                  </svg>
                  {p.nombre}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /*
   * Más alta que ancha, como la pantalla de un móvil (o una story/reel): 9:16 en vez del
   * 4:5 de una publicación normal de Instagram. Aquí lo que se enseña es justo ese tipo
   * de formato vertical, así que la ventana se parece a lo que va a haber dentro.
   */
  .ventana {
    aspect-ratio: 9 / 16;
  }

  .etiqueta svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .etiqueta svg .relleno {
    fill: currentColor;
    stroke: none;
  }
</style>

<script>
  /*
   * Cada ventana sale del servidor con el primer medio visible (foto o vídeo, sin
   * reproducir) y los demás con `hidden`, para que sin JavaScript se vea igualmente algo
   * fijo —y el enlace de esa primera publicación— en vez de nada. Aquí se elige uno al
   * azar de entre fotos y vídeos mezclados, se cambia cuál queda visible, se actualiza el
   * enlace de la tarjeta al de esa publicación en concreto (o al del perfil, si no tiene
   * uno propio) y, si es un vídeo, se pone en marcha.
   *
   * El vídeo elegido solo se reproduce si no se ha pedido «menos movimiento»: por eso no
   * lleva el atributo `autoplay` en el HTML —eso reproduciría igual aunque el sistema
   * pida reducir la animación—, sino que se arranca aquí a mano, ya comprobada la
   * preferencia.
   */
  const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const tarjeta of document.querySelectorAll<HTMLAnchorElement>('[data-enlace-respaldo]')) {
    const caja = tarjeta.querySelector<HTMLElement>('[data-capturas]');
    if (!caja) continue;

    const medios = [...caja.querySelectorAll<HTMLElement>('[data-captura]')];
    const elegido = medios.length > 1 ? Math.floor(Math.random() * medios.length) : 0;

    for (const medio of medios) {
      const visible = Number(medio.dataset.captura) === elegido;
      medio.hidden = !visible;
      if (visible) {
        tarjeta.href = medio.dataset.enlace || tarjeta.dataset.enlaceRespaldo!;
        if (medio instanceof HTMLVideoElement && !reducirMovimiento) {
          medio.play().catch(() => {});
        }
      }
    }
  }
</script>
