---
/**
 * La maqueta del bolso a medida: un dibujo que se rehace solo con lo que se va
 * eligiendo al lado —forma, color y detalles—, para ver la pieza antes de pedirla.
 *
 * Es un dibujo y no una foto por lo evidente: tres formas por muchos colores por seis
 * detalles son cientos de combinaciones, y ninguna existe todavía.
 *
 * Toda la geometría sale de src/lib/maqueta.ts, medida sobre las fotos de las piezas:
 * el punto grueso de trapillo (cada punto una uve de dos granos, vuelta a vuelta), las
 * asas en trenza, las flores de cinco pétalos, el lazo de cordón, los flecos con cuentas
 * y el monedero de solapa. El servidor dibuja la primera versión, que se ve aunque no
 * cargue el JavaScript; el script de abajo la redibuja y la anima.
 *
 * El configurador solo pone tres atributos —`data-forma`, `data-extras` y `data-tonos`
 * (uno o dos colores separados por espacio)— y el dibujo reacciona a ellos:
 *
 * - Al aparecer en pantalla, el bolso se teje: vuelta a vuelta desde la base.
 * - Al cambiar de forma, el bolso se estira o se encoge hasta la nueva, con un pequeño
 *   rebote, y el asa crece o se recoge. No hay dos dibujos que se cruzan: es el mismo.
 * - Al cambiar de color, el color nuevo sube vuelta a vuelta desde abajo, como si se
 *   volviera a tejer; luego se tiñen el remate, el asa y los detalles.
 *
 * Con dos colores no se pintan franjas: los dos hilos van tejidos juntos, como en el
 * bolso granate de la flor, y en cada grano se ve una hebra del segundo color retorcida
 * con el primero. Lo mismo en el asa, el remate, los cordones, la flor y el monedero.
 * - Cada detalle entra a su manera: la flor abre los pétalos, los flecos caen y se
 *   balancean, el lazo se anuda y suelta las colas, el monedero llega y se posa.
 *
 * No lo leen los lectores de pantalla: lo elegido se cuenta en palabras justo debajo, en
 * «Tu bolso», y repetirlo aquí sería ruido.
 */
import Cadeneta from './Cadeneta.astro';
import {
  FORMAS,
  FLECOS,
  GROSOR,
  anclas,
  asa,
  boca,
  caja,
  cadeneta,
  cuerpo,
  muestrearCubica,
  ranura,
  rectanguloRedondo,
  remate,
  relevo,
  sombra,
  tejido,
  trenza,
} from '../lib/maqueta';

const GRIS = '#B6B2AE';
const p = FORMAS.tote;
const c = caja(p);
const dCuerpo = cuerpo(p, c);
const cRemate = cadeneta(remate(p, c), GROSOR.remate);
const b = boca(p, c);
const cBoca = cadeneta(b.borde, GROSOR.boca);
const cAsa = trenza(asa(p, c), p.asaGrosor);
const t = tejido(c);
const r = ranura(p, c);
const cRanura = cadeneta(rectanguloRedondo(r.x, r.y, r.ancho, r.alto, r.radio), GROSOR.ranura, true);
const s = sombra(p);
const a = anclas(p, c);
const paradas = relevo(GRIS, GRIS, 0);

// Los detalles se dibujan una vez, en coordenadas propias alrededor de su punto de anclaje.
const PETALO = 'M0 -2.6C-8.3 -4.9-11.2 -19 0 -21.8C11.2 -19 8.3 -4.9 0 -2.6Z';
const BUCLES = 'M0 0C-5 -10-19 -12-19 -3S-7 3 0 0M0 0C5 -10 19 -12 19 -3S7 3 0 0';
const COLAS = ['M-1.5 2C-4 10-9 16-7 30', 'M1.5 2C5 11 2 20 6 31'];
const NUDITOS = [
  [-7, 30.5],
  [6, 31.5],
];
const CUENTAS = ['#D8B98A', '#8C5A3B', '#F1E9DC', '#5E8AA8', '#C86F55'];
const flecos = Array.from({ length: FLECOS }, (_, i) => {
  const largo = 24 + ((i * 7) % 5) * 1.6;
  const dx = ((i * 5) % 3) - 1;
  return {
    d: `M0 0C1.4 ${largo * 0.35}-1.4 ${largo * 0.66} ${dx} ${largo}`,
    cuenta: [dx, largo + 2.6] as const,
    color: CUENTAS[(i * 3) % CUENTAS.length],
  };
});
const cajaMonedero = { yT: -16, yB: 16, xLT: -24, xRT: 24, xLB: -24, xRB: 24 };
const dMonedero = 'M-24 -12A4 4 0 0 1-20 -16H20A4 4 0 0 1 24 -12V9A7 7 0 0 1 17 16H-17A7 7 0 0 1-24 9Z';
const dSolapa = 'M-24 -12A4 4 0 0 1-20 -16H20A4 4 0 0 1 24 -12V-3C24 2 12 7 0 8C-12 7-24 2-24 -3Z';
const cSolapa = cadeneta(
  [
    ...muestrearCubica([[-23, -3], [-23, 2], [-11, 6.8], [0, 7.6]], 14),
    ...muestrearCubica([[0, 7.6], [11, 6.8], [23, 2], [23, -3]], 14).slice(1),
  ],
  GROSOR.solapa
);
const tMonedero = tejido(cajaMonedero, 0, 7);
---

<svg
  class="maqueta"
  viewBox="0 0 280 310"
  data-maqueta
  data-forma="tote"
  data-extras=""
  data-tonos={GRIS}
  aria-hidden="true"
>
  <defs>
    {/*
      Los dos hilos del cuerpo —el principal y la hebra del segundo—, como degradados en
      vertical: así el color nuevo se puede «tejer» de abajo arriba (ver `relevo`).
    */}
    <linearGradient id="lana" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="310" set:html={paradas} />
    <linearGradient id="hebra" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="310" set:html={paradas} />
    {/* Los mismos dos hilos para el asa, el remate y los adornos; iguales con un solo color. */}
    <linearGradient id="lana-a"><stop class="tono" data-tono="a" offset="0" stop-color={GRIS}></stop></linearGradient>
    <linearGradient id="lana-b"><stop class="tono" data-tono="b" offset="0" stop-color={GRIS}></stop></linearGradient>

    {/* El bolso no es una silueta plana: le entra luz por arriba y se apaga abajo. */}
    <linearGradient id="bulto" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".16"></stop>
      <stop offset=".4" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity=".26"></stop>
    </linearGradient>
    {/* Y tiene fondo: los costados se van de sombra, que es lo que lo redondea. */}
    <linearGradient id="lados" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity=".26"></stop>
      <stop offset=".14" stop-color="#000" stop-opacity="0"></stop>
      <stop offset=".86" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity=".26"></stop>
    </linearGradient>
    <radialGradient id="suelo">
      <stop offset="0" stop-color="#000" stop-opacity=".5"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
    </radialGradient>
    {/* El forro de lunares, como el del bolso amarillo de volantes. */}
    <pattern id="lunares" width="7" height="7" patternUnits="userSpaceOnUse">
      <rect width="7" height="7" fill="#EFE7D8"></rect>
      <circle cx="1.75" cy="1.75" r="1.05" fill="#2B2623"></circle>
      <circle cx="5.25" cy="5.25" r="1.05" fill="#2B2623"></circle>
    </pattern>

    <clipPath id="recorte-cuerpo"><path data-d="cuerpo" d={dCuerpo}></path></clipPath>
    <clipPath id="recorte-boca"><ellipse data-boca cx={b.cx} cy={b.cy} rx={b.rx} ry={b.ry}></ellipse></clipPath>
    <clipPath id="recorte-tejer"><rect data-tejer x="0" y="0" width="280" height="310"></rect></clipPath>
    <clipPath id="recorte-monedero"><path d={dMonedero}></path></clipPath>
    <clipPath id="recorte-bolsillo"><rect data-bolsillo-barrido x="-60" y="-40" width="120" height="80"></rect></clipPath>
  </defs>

  {/* La tarima: el bolso necesita apoyarse en algo, o flota en mitad del panel. */}
  <rect class="tarima" width="280" height="310"></rect>

  <g data-grupo-sombra>
    <ellipse class="sombra" data-sombra cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry}></ellipse>
    <ellipse class="sombra-contacto" data-sombra-contacto cx={s.cx} cy={s.cy - 2} rx={s.rxContacto} ry="3.5"></ellipse>
  </g>

  <g class="bolso" data-bolso clip-path="url(#recorte-tejer)">
    {/* Los flecos, detrás del cuerpo: así nacen de dentro del borde y no pegados encima. */}
    <g class="extra" data-extra="flecos">
      {
        flecos.map((fl, i) => (
          <g data-ancla-fleco transform={`translate(${a.flecos[i]![0]} ${a.flecos[i]![1]})`}>
            <g class="an" data-an>
              <path class="cordon-borde" d={fl.d}></path>
              <path class="cordon" d={fl.d}></path>
              <path class="cordon-hebra" d={fl.d}></path>
              <circle class="cuenta-borde" cx={fl.cuenta[0]} cy={fl.cuenta[1]} r="3.2"></circle>
              <circle cx={fl.cuenta[0]} cy={fl.cuenta[1]} r="2.7" fill={fl.color}></circle>
              <circle class="cuenta-luz" cx={fl.cuenta[0] - 0.9} cy={fl.cuenta[1] - 0.9} r="0.9"></circle>
            </g>
          </g>
        ))
      }
    </g>

    {/* La boca: el fondo de dentro, el forro si lo lleva y el borde de atrás. */}
    <g data-grupo-boca>
      <ellipse class="boca-interior" data-boca cx={b.cx} cy={b.cy} rx={b.rx} ry={b.ry}></ellipse>
      <ellipse class="boca-sombra" data-boca cx={b.cx} cy={b.cy} rx={b.rx} ry={b.ry}></ellipse>
      <g class="forro" clip-path="url(#recorte-boca)">
        <ellipse class="forro-tela" data-boca cx={b.cx} cy={b.cy} rx={b.rx} ry={b.ry}></ellipse>
        <ellipse class="forro-sombra" data-boca cx={b.cx} cy={b.cy} rx={b.rx} ry={b.ry}></ellipse>
      </g>
      <Cadeneta nombre="boca" cad={cBoca} grosor={GROSOR.boca} />
    </g>

    <g data-grupo-asa>
      <Cadeneta nombre="asa" cad={cAsa} grosor={p.asaGrosor} halo />
    </g>

    <path class="cuerpo" data-d="cuerpo" d={dCuerpo}></path>
    {/* Oscurecido de fondo: lo que queda entre grano y grano se ve hundido, en sombra. */}
    <path class="cuerpo-hondo" data-d="cuerpo" d={dCuerpo}></path>
    <g clip-path="url(#recorte-cuerpo)">
      <g data-tejido>
        <path class="g-sombra" data-t="sombra" d={t.sombra}></path>
        <path class="g-lana" data-t="lana" d={t.lana}></path>
        <path class="g-hebra" data-t="hebra" d={t.hebra}></path>
        <path class="g-luz" data-t="luz" d={t.luz}></path>
        <path class="surcos" data-t="surcos" d={t.surcos}></path>
      </g>
      <path class="volumen" data-d="cuerpo" d={dCuerpo}></path>
      <path class="costados" data-d="cuerpo" d={dCuerpo}></path>
      {/* La vuelta que se está tejiendo, un pelo más clara: es la que acaba de salir. */}
      <rect class="brillo" data-brillo x="0" y="0" width="280" height="12" opacity="0"></rect>

      {/*
        El bolsillo interior no se ve desde fuera —está dentro—, así que se dibuja como se
        dibuja lo que queda detrás de algo: a trazos, con una línea oscura y otra clara un
        pelo por encima para que no desaparezca ni sobre lana blanca ni sobre negra.
      */}
      <g class="extra" data-extra="bolsillo">
        <g data-ancla-bolsillo transform={`translate(${a.bolsillo.x} ${a.bolsillo.y})`}>
          <g clip-path="url(#recorte-bolsillo)">
            <rect class="bolsillo-fondo" data-bolsillo></rect>
            <rect class="bolsillo-luz" data-bolsillo></rect>
            <rect class="bolsillo-linea" data-bolsillo></rect>
            <path class="bolsillo-luz" data-bolsillo-jareta></path>
            <path class="bolsillo-linea" data-bolsillo-jareta></path>
          </g>
        </g>
      </g>
    </g>
    {/* El contorno de bolitas: el borde de un tejido de punto nunca es una línea recta. */}
    <path class="borde-bolas" data-d="cuerpo" d={dCuerpo}></path>
    <path class="borde-luz" data-d="cuerpo" d={dCuerpo}></path>

    {/* El remate: la última vuelta, más gruesa, que se nota en todas las piezas. */}
    <path class="remate-sombra" data-cad="remate" data-parte="caida" d={cRemate.linea} stroke-width={GROSOR.remate}></path>
    <Cadeneta nombre="remate" cad={cRemate} grosor={GROSOR.remate} />

    {/* El agarre del bolso de mano: una ranura abierta en el propio tejido. */}
    <g data-grupo-ranura opacity="0">
      <rect class="boca-interior" data-ranura x={r.x} y={r.y} width={r.ancho} height={r.alto} rx={r.radio}></rect>
      <rect class="boca-sombra" data-ranura x={r.x} y={r.y} width={r.ancho} height={r.alto} rx={r.radio}></rect>
      <rect class="forro forro-tela" data-ranura x={r.x} y={r.y} width={r.ancho} height={r.alto} rx={r.radio}></rect>
      <Cadeneta nombre="ranura" cad={cRanura} grosor={GROSOR.ranura} />
    </g>

    {/* Las anillas doradas donde la correa se engancha al bolso. */}
    <g data-grupo-anillas opacity="0">
      {
        [-1, 1].map((lado) => (
          <g data-anilla={lado}>
            <circle class="anilla-borde" r="5.8"></circle>
            <circle class="anilla" r="5.8"></circle>
            <circle class="anilla-luz" r="5.8"></circle>
          </g>
        ))
      }
    </g>

    <g class="extra" data-extra="flor">
      <g data-ancla-flor transform={`translate(${a.flor[0]} ${a.flor[1]})`}>
        {
          [0, 1, 2, 3, 4].map((k) => (
            <g class="an" data-petalo>
              <path class="petalo" d={PETALO} transform={`rotate(${k * 72 + 18})`}></path>
              <path class="petalo-hebra" d={PETALO} transform={`rotate(${k * 72 + 18 + (k % 2 ? 7 : -7)}) scale(.42 .9)`}></path>
              <path class="petalo-luz" d={PETALO} transform={`rotate(${k * 72 + 18}) scale(.62)`}></path>
              <path class="petalo-vena" d="M0 -6V-17" transform={`rotate(${k * 72 + 18})`}></path>
            </g>
          ))
        }
        <g class="an" data-centro>
          <circle class="centro" r="6.4"></circle>
          <circle class="centro-sombra" r="6.4"></circle>
          <circle class="centro-puntos" r="4"></circle>
        </g>
      </g>
    </g>

    <g class="extra" data-extra="lazos">
      <g data-ancla-lazo transform={`translate(${a.lazo[0]} ${a.lazo[1]}) scale(1.3)`}>
        {
          COLAS.map((d) => (
            <>
              <path class="cordon-borde cola" d={d} pathLength="1"></path>
              <path class="cordon cola" d={d} pathLength="1"></path>
            </>
          ))
        }
        {NUDITOS.map(([x, y]) => <circle class="nudito" data-nudito cx={x} cy={y} r="2.2"></circle>)}
        <g class="an" data-bucles>
          <path class="cordon-borde" d={BUCLES}></path>
          <path class="cordon" d={BUCLES}></path>
          <path class="cordon-hebra" d={BUCLES}></path>
          <path class="cordon-luz" d={BUCLES}></path>
          <ellipse class="nudo" rx="3.8" ry="4.4"></ellipse>
        </g>
      </g>
    </g>

    {/* El monedero a juego: un sobrecito de solapa con su broche, apoyado delante. */}
    <g class="extra" data-extra="monedero">
      <g data-ancla-monedero transform={`translate(${a.monedero[0]} ${a.monedero[1]}) rotate(-7)`}>
        <g class="an" data-an>
          <ellipse class="monedero-sombra" cx="2" cy="17" rx="27" ry="4"></ellipse>
          <path class="borde-luz" d={dMonedero}></path>
          <path class="monedero" d={dMonedero}></path>
          <g clip-path="url(#recorte-monedero)">
            <path class="g-sombra" d={tMonedero.sombra}></path>
            <path class="g-lana-a" d={tMonedero.lana}></path>
            <path class="g-lana-b" d={tMonedero.hebra}></path>
            <path class="g-luz" d={tMonedero.luz}></path>
            <path class="volumen" d={dMonedero}></path>
          </g>
          <path class="borde-bolas" d={dMonedero}></path>
          <path class="solapa" d={dSolapa}></path>
          <path class="solapa-luz" d={dSolapa}></path>
          <Cadeneta nombre="solapa" cad={cSolapa} grosor={GROSOR.solapa} />
          <circle class="broche" cx="0" cy="4.6" r="2.9"></circle>
          <circle class="broche-luz" cx="-0.8" cy="3.8" r="0.9"></circle>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  .maqueta {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .tarima {
    fill: rgb(255 255 255 / 0.05);
  }
  .sombra {
    fill: url(#suelo);
  }
  .sombra-contacto {
    fill: rgb(0 0 0 / 0.3);
  }

  .tono {
    transition: stop-color 360ms var(--ease-salida);
  }

  /* --- El cuerpo y su punto ------------------------------------------------------ */
  .cuerpo,
  .g-lana {
    fill: url(#lana);
  }
  .g-lana-a {
    fill: url(#lana-a);
  }
  .g-lana-b {
    fill: url(#lana-b);
  }
  .g-hebra {
    fill: url(#hebra);
  }
  /*
   * El punto, las sombras y los contornos son negros y blancos translúcidos, nunca un
   * color propio: así la misma textura vale para la lana blanca y para la negra.
   */
  .g-sombra {
    fill: rgb(0 0 0 / 0.3);
  }
  .g-luz {
    fill: rgb(255 255 255 / 0.2);
  }
  .surcos {
    fill: none;
    stroke: rgb(0 0 0 / 0.22);
    stroke-width: 1.7;
  }
  .volumen {
    fill: url(#bulto);
  }
  .costados {
    fill: url(#lados);
  }
  .brillo {
    fill: #fff;
  }
  .borde-bolas {
    fill: none;
    stroke: rgb(0 0 0 / 0.26);
    stroke-width: 3.2;
    stroke-dasharray: 0 6.4;
    stroke-linecap: round;
  }
  /* Un filo claro alrededor: sin él, la lana negra se pierde dentro del panel oscuro. */
  .borde-luz {
    fill: none;
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 2;
  }

  /* --- El remate -------------------------------------------------------------- */
  /* La sombra que deja el remate sobre la primera vuelta del cuerpo. */
  .remate-sombra {
    fill: none;
    stroke: rgb(0 0 0 / 0.22);
    stroke-linecap: round;
    transform: translateY(2.4px);
  }
  .cuerpo-hondo {
    fill: rgb(0 0 0 / 0.24);
  }

  /* --- La boca ----------------------------------------------------------------- */
  .boca-interior {
    fill: url(#lana-a);
  }
  .boca-sombra {
    fill: rgb(0 0 0 / 0.55);
  }
  .forro-tela {
    fill: url(#lunares);
  }
  .forro-sombra {
    fill: rgb(0 0 0 / 0.2);
  }
  /* El forro se ve por la boca, que es justo por donde se vería de verdad. */
  .forro {
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity 360ms var(--ease-salida),
      transform 480ms var(--ease-salida);
  }
  .maqueta[data-extras~='forro'] .forro {
    opacity: 1;
    transform: none;
  }

  /* --- Las anillas ------------------------------------------------------------ */
  .anilla,
  .anilla-borde,
  .anilla-luz {
    fill: none;
  }
  .anilla {
    stroke: #c9a45c;
    stroke-width: 2.6;
  }
  .anilla-borde {
    stroke: rgb(0 0 0 / 0.4);
    stroke-width: 4.4;
  }
  .anilla-luz {
    stroke: #f6e3ab;
    stroke-width: 0.9;
    stroke-dasharray: 5 31.4;
    stroke-dashoffset: 17;
  }

  /* --- Los detalles ------------------------------------------------------------ */
  .extra {
    display: none;
  }
  .extra[data-visible] {
    display: inline;
  }
  /*
   * Todo lo que se anima gira y crece desde su propio punto de anclaje (el 0,0 de su
   * grupo): el centro de la flor, el nudo del lazo, la parte de arriba de cada fleco.
   */
  .an {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .petalo {
    fill: url(#lana-a);
    stroke: rgb(0 0 0 / 0.34);
    stroke-width: 1.3;
  }
  .petalo-hebra {
    fill: url(#lana-b);
  }
  .petalo-luz {
    fill: rgb(255 255 255 / 0.16);
  }
  .petalo-vena {
    fill: none;
    stroke: rgb(0 0 0 / 0.2);
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  /* El centro de la flor, al revés que los pétalos: del segundo hilo, para que se lea. */
  .centro {
    fill: url(#lana-b);
  }
  .centro-sombra {
    fill: rgb(0 0 0 / 0.3);
    stroke: rgb(0 0 0 / 0.36);
    stroke-width: 1.3;
  }
  .centro-puntos {
    fill: none;
    stroke: rgb(255 255 255 / 0.4);
    stroke-width: 1.5;
    stroke-dasharray: 0 2.4;
    stroke-linecap: round;
  }

  .cordon,
  .cordon-borde,
  .cordon-hebra,
  .cordon-luz {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cordon {
    stroke: url(#lana-a);
    stroke-width: 3.4;
  }
  /* El segundo hilo, enroscado en el cordón a tramos. */
  .cordon-hebra {
    stroke: url(#lana-b);
    stroke-width: 2.4;
    stroke-dasharray: 2.4 2.6;
  }
  .cordon-borde {
    stroke: rgb(0 0 0 / 0.38);
    stroke-width: 5.4;
  }
  /* El retorcido del cordón: sin él, una raya lisa se lee como un cable. */
  .cordon-luz {
    stroke: rgb(255 255 255 / 0.28);
    stroke-width: 1.1;
    stroke-dasharray: 1.6 3;
  }
  .nudo {
    fill: url(#lana-a);
    stroke: rgb(0 0 0 / 0.38);
    stroke-width: 1.3;
  }
  .nudito {
    fill: url(#lana-a);
    stroke: rgb(0 0 0 / 0.38);
    stroke-width: 1;
  }
  .cuenta-borde {
    fill: rgb(0 0 0 / 0.35);
  }
  .cuenta-luz {
    fill: rgb(255 255 255 / 0.55);
  }

  .monedero {
    fill: url(#lana-a);
  }
  .monedero-sombra {
    fill: rgb(0 0 0 / 0.28);
  }
  .solapa {
    fill: url(#lana-a);
    stroke: rgb(0 0 0 / 0.3);
    stroke-width: 1.2;
  }
  .solapa-luz {
    fill: rgb(255 255 255 / 0.08);
  }
  .broche {
    fill: #c9a45c;
    stroke: rgb(0 0 0 / 0.4);
    stroke-width: 1;
  }
  .broche-luz {
    fill: #f6e3ab;
  }

  .bolsillo-linea,
  .bolsillo-luz {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 5 4.5;
    stroke-linecap: round;
  }
  .bolsillo-linea {
    stroke: rgb(0 0 0 / 0.42);
  }
  .bolsillo-luz {
    stroke: rgb(255 255 255 / 0.32);
    transform: translateY(-1px);
  }
  .bolsillo-fondo {
    fill: rgb(255 255 255 / 0.07);
  }
</style>

<script>
  import {
    FORMAS,
    FILA,
    GROSOR,
    anclas,
    asa,
    boca,
    caja,
    cadeneta,
    cuerpo,
    mezclar,
    ranura,
    rectanguloRedondo,
    remate,
    relevo,
    sombra,
    tejido,
    trenza,
    type Cadeneta,
    type FormaId,
    type Parametros,
  } from '../lib/maqueta';

  const svg = document.querySelector<SVGSVGElement>('[data-maqueta]');
  if (svg) iniciar(svg);

  function iniciar(svg: SVGSVGElement) {
    const uno = <T extends Element = SVGElement>(sel: string) => svg.querySelector<T>(sel)!;
    const todos = <T extends Element = SVGElement>(sel: string) => [...svg.querySelectorAll<T>(sel)];
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

    const el = {
      cuerpo: todos('[data-d="cuerpo"]'),
      boca: todos('[data-boca]'),
      grupoBoca: uno('[data-grupo-boca]'),
      grupoAsa: uno('[data-grupo-asa]'),
      tejido: uno('[data-tejido]'),
      t: {
        sombra: uno('[data-t="sombra"]'),
        lana: uno('[data-t="lana"]'),
        luz: uno('[data-t="luz"]'),
        hebra: uno('[data-t="hebra"]'),
        surcos: uno('[data-t="surcos"]'),
      },
      ranura: todos('[data-ranura]'),
      grupoRanura: uno('[data-grupo-ranura]'),
      anillas: todos('[data-anilla]'),
      grupoAnillas: uno('[data-grupo-anillas]'),
      sombra: uno('[data-sombra]'),
      sombraContacto: uno('[data-sombra-contacto]'),
      grupoSombra: uno('[data-grupo-sombra]'),
      lana: uno('#lana'),
      hebra: uno('#hebra'),
      tonos: { a: uno('[data-tono="a"]'), b: uno('[data-tono="b"]') },
      tejer: uno('[data-tejer]'),
      brillo: uno('[data-brillo]'),
      bolso: uno('[data-bolso]'),
      anclaFlor: uno('[data-ancla-flor]'),
      anclaLazo: uno('[data-ancla-lazo]'),
      anclaMonedero: uno('[data-ancla-monedero]'),
      anclaBolsillo: uno('[data-ancla-bolsillo]'),
      bolsillo: todos('[data-bolsillo]'),
      jareta: todos('[data-bolsillo-jareta]'),
      barrido: uno('[data-bolsillo-barrido]'),
      flecos: todos('[data-ancla-fleco]'),
      extras: Object.fromEntries(todos('[data-extra]').map((e) => [e.dataset.extra!, e])),
    };

    const partes = (nombre: string) =>
      todos(`[data-cad="${nombre}"]`).map((e) => [e.dataset.parte!, e] as const);
    const cad = { asa: partes('asa'), remate: partes('remate'), boca: partes('boca'), ranura: partes('ranura') };
    const EXTRA_TRAZO: Record<string, number> = { halo: 4.5, borde: 2.6 };

    function ponerCadeneta(piezas: (readonly [string, SVGElement])[], c: Cadeneta, grosor: number) {
      for (const [parte, e] of piezas) {
        if (parte === 'sombra' || parte === 'lana' || parte === 'luz' || parte === 'hebra') e.setAttribute('d', c[parte]);
        else {
          e.setAttribute('d', c.linea);
          e.setAttribute('stroke-width', String(grosor + (EXTRA_TRAZO[parte] ?? 0)));
        }
      }
    }

    // ------------------------------------------------------------------ utilidades

    const fotogramas = new Map<string, number>();
    /** Una animación a mano, fotograma a fotograma, para lo que son atributos de SVG. */
    function animar(clave: string, ms: number, paso: (t: number) => void, fin?: () => void) {
      cancelAnimationFrame(fotogramas.get(clave) ?? 0);
      const t0 = performance.now();
      const tic = (ahora: number) => {
        const t = Math.min(1, (ahora - t0) / ms);
        paso(t);
        if (t < 1) fotogramas.set(clave, requestAnimationFrame(tic));
        else {
          fotogramas.delete(clave);
          fin?.();
        }
      };
      fotogramas.set(clave, requestAnimationFrame(tic));
    }

    /**
     * Un muelle amortiguado: pasa un poco del sitio y vuelve. Es lo que hace que el bolso
     * se asiente al cambiar de forma en vez de detenerse en seco.
     */
    const muelle = (t: number) => {
      if (t >= 1) return 1;
      const z = 0.58;
      const w = 2 * Math.PI * 1.3;
      const wd = w * Math.sqrt(1 - z * z);
      return 1 - Math.exp(-z * w * t) * (Math.cos(wd * t) + ((z * w) / wd) * Math.sin(wd * t));
    };
    const salida = (t: number) => 1 - (1 - t) ** 3;

    const set = (e: Element, attrs: Record<string, string | number>) => {
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    };

    // ------------------------------------------------------------------ el estado

    let formaId: FormaId = 'tote';
    let mostrado: Parametros = { ...FORMAS.tote };
    /** Con qué forma se generaron los puntos: mientras cambia de forma se estiran, y al
     *  terminar se vuelven a tejer a la medida nueva. */
    let tejidoDe: Parametros = { ...FORMAS.tote };
    let transformando = false;

    let tonos: string[] = ['#B6B2AE'];
    let tonosViejos: string[] = tonos;
    /** Hasta dónde ha subido el color nuevo; 0 es que ya lo cubre todo. */
    let hasta = 0;

    let extras = new Set<string>();
    let vivo = false;

    // ------------------------------------------------------------------ dibujar

    function pintarLana() {
      el.lana.innerHTML = relevo(tonos[0]!, tonosViejos[0]!, hasta);
      el.hebra.innerHTML = relevo(tonos[1] ?? tonos[0]!, tonosViejos[1] ?? tonosViejos[0]!, hasta);
    }

    function regenerarTejido(p: Parametros) {
      const t = tejido(caja(p));
      el.t.sombra.setAttribute('d', t.sombra);
      el.t.lana.setAttribute('d', t.lana);
      el.t.luz.setAttribute('d', t.luz);
      el.t.hebra.setAttribute('d', t.hebra);
      el.t.surcos.setAttribute('d', t.surcos);
      el.tejido.removeAttribute('transform');
      tejidoDe = { ...p };
    }

    function dibujar(p: Parametros) {
      const c = caja(p);
      const d = cuerpo(p, c);
      for (const e of el.cuerpo) e.setAttribute('d', d);
      ponerCadeneta(cad.remate, cadeneta(remate(p, c), GROSOR.remate), GROSOR.remate);

      const b = boca(p, c);
      for (const e of el.boca) set(e, { cx: b.cx, cy: b.cy, rx: b.rx, ry: b.ry });
      const bocaVisible = Math.min(1, Math.max(0, p.boca / 3));
      if (bocaVisible > 0) ponerCadeneta(cad.boca, cadeneta(b.borde, GROSOR.boca), GROSOR.boca);
      el.grupoBoca.setAttribute('opacity', String(bocaVisible));

      const visible = Math.min(1, Math.max(0, p.asaVisible));
      const pts = asa({ ...p, asaAlto: Math.max(0, p.asaAlto) }, c);
      const grosor = Math.max(0, p.asaGrosor);
      if (visible > 0.01) ponerCadeneta(cad.asa, trenza(pts, grosor), grosor);
      el.grupoAsa.setAttribute('opacity', String(visible));

      el.anillas.forEach((e, i) => {
        const [x, y] = pts[i === 0 ? 0 : 3]!;
        e.setAttribute('transform', `translate(${x} ${y})`);
      });
      el.grupoAnillas.setAttribute('opacity', String(Math.min(1, Math.max(0, p.anillas))));

      const r = ranura(p, c);
      const ranuraVisible = Math.min(1, Math.max(0, p.ranura));
      for (const e of el.ranura) set(e, { x: r.x, y: r.y, width: Math.max(0, r.ancho), height: r.alto });
      if (ranuraVisible > 0.01) {
        const borde = rectanguloRedondo(r.x, r.y, Math.max(1, r.ancho), r.alto, r.radio);
        ponerCadeneta(cad.ranura, cadeneta(borde, GROSOR.ranura, true), GROSOR.ranura);
      }
      el.grupoRanura.setAttribute('opacity', String(ranuraVisible));

      const s = sombra(p);
      set(el.sombra, { cx: s.cx, cy: s.cy, rx: s.rx, ry: s.ry });
      set(el.sombraContacto, { cx: s.cx, cy: s.cy - 2, rx: s.rxContacto });

      // Mientras cambia de forma, los puntos se estiran con el bolso en vez de rehacerse
      // en cada fotograma: es más barato y se lee igual, como un tejido que da de sí.
      if (transformando) {
        const c0 = caja(tejidoDe);
        const sx = (c.xRB - c.xLB) / (c0.xRB - c0.xLB);
        const sy = (c.yB - c.yT) / (c0.yB - c0.yT);
        el.tejido.setAttribute(
          'transform',
          `translate(140 ${c.yB}) scale(${sx.toFixed(4)} ${sy.toFixed(4)}) translate(-140 ${-c0.yB})`
        );
      } else regenerarTejido(p);

      const a = anclas(p, c);
      el.anclaFlor.setAttribute('transform', `translate(${a.flor[0]} ${a.flor[1]})`);
      el.anclaLazo.setAttribute('transform', `translate(${a.lazo[0]} ${a.lazo[1]})`);
      el.anclaMonedero.setAttribute('transform', `translate(${a.monedero[0]} ${a.monedero[1]}) rotate(-7)`);
      el.anclaBolsillo.setAttribute('transform', `translate(${a.bolsillo.x} ${a.bolsillo.y})`);
      const bw = a.bolsillo.ancho;
      const bh = a.bolsillo.alto;
      for (const e of el.bolsillo) set(e, { x: -bw / 2, y: -bh / 2, width: bw, height: bh, rx: 6 });
      for (const e of el.jareta) e.setAttribute('d', `M${-bw / 2 + 1} ${-bh / 2 + 10}h${bw - 2}`);
      el.flecos.forEach((e, i) => e.setAttribute('transform', `translate(${a.flecos[i]![0]} ${a.flecos[i]![1]})`));

      pintarLana();
    }

    function ponerTono(clave: 'a' | 'b', color: string, suave: boolean) {
      const stop = el.tonos[clave] as SVGStopElement;
      if (!suave) {
        stop.style.transition = 'none';
        stop.style.stopColor = color;
        void stop.getBoundingClientRect();
        stop.style.transition = '';
      } else stop.style.stopColor = color;
    }
    const ponerTonos = (suave: boolean) => {
      ponerTono('a', tonos[0]!, suave);
      ponerTono('b', tonos[1] ?? tonos[0]!, suave);
    };

    // ------------------------------------------------------------------ animaciones

    /** De una forma a otra, con el mismo bolso estirándose y un pequeño rebote. */
    function cambiarForma(id: FormaId) {
      const desde = { ...mostrado };
      const a = FORMAS[id];
      if (quieto.matches) {
        transformando = false;
        mostrado = { ...a };
        dibujar(mostrado);
        return;
      }
      transformando = true;
      animar(
        'forma',
        760,
        (t) => {
          mostrado = mezclar(desde, a, muelle(t));
          dibujar(mostrado);
        },
        () => {
          transformando = false;
          mostrado = { ...a };
          dibujar(mostrado);
        }
      );
    }

    /**
     * El color nuevo sube vuelta a vuelta desde la base, a saltos de una vuelta —no un
     * barrido suave, que parecería pintura—, con la vuelta recién tejida un poco más
     * clara. Cuando llega arriba se tiñen el remate, el asa y los detalles.
     */
    function cambiarColor(nuevos: string[]) {
      cancelAnimationFrame(fotogramas.get('color') ?? 0);
      tonosViejos = tonos.length && hasta === 0 ? tonos : tonosViejos;
      tonos = nuevos;
      if (quieto.matches) {
        tonosViejos = nuevos;
        hasta = 0;
        pintarLana();
        ponerTonos(true);
        return;
      }
      const c = caja(mostrado);
      const vueltas = Math.ceil((c.yB - c.yT) / FILA) + 1;
      let tenido = false;
      animar(
        'color',
        vueltas * 42,
        (t) => {
          const cc = caja(mostrado);
          const fila = Math.floor(t * vueltas);
          hasta = cc.yB + 4 - fila * FILA;
          pintarLana();
          set(el.brillo, { y: hasta, opacity: 0.2 * (1 - t * 0.5) });
          if (!tenido && t > 0.72) {
            tenido = true;
            ponerTonos(true);
          }
        },
        () => {
          hasta = 0;
          tonosViejos = tonos;
          pintarLana();
          el.brillo.setAttribute('opacity', '0');
          if (!tenido) ponerTonos(true);
        }
      );
    }

    /** El «plof» del bolso al recibir un detalle: se aplasta un pelo y recupera. */
    function asentar() {
      if (quieto.matches) return;
      const g = caja(mostrado).yB;
      el.bolso.style.transformOrigin = `140px ${g}px`;
      el.bolso.animate(
        [
          { transform: 'none' },
          { transform: 'scale(1.018, 0.982)', offset: 0.3 },
          { transform: 'scale(0.994, 1.006)', offset: 0.65 },
          { transform: 'none' },
        ],
        { duration: 420, easing: 'ease-out' }
      );
    }

    const opciones = (ms: number, retraso = 0, easing = 'cubic-bezier(0.2, 0.8, 0.2, 1)') => ({
      duration: ms,
      delay: retraso,
      easing,
      fill: 'backwards' as FillMode,
    });

    const cancelar = (raiz: Element) => {
      for (const e of [raiz, ...raiz.querySelectorAll('*')]) for (const an of e.getAnimations()) an.cancel();
    };

    /** Cómo entra cada detalle. Todas duran menos de un segundo y ninguna se repite. */
    const entradas: Record<string, (g: SVGElement) => void> = {
      flor(g) {
        g.querySelectorAll('[data-petalo]').forEach((p, i) =>
          p.animate(
            [
              { transform: 'scale(0) rotate(-60deg)', opacity: 0 },
              { transform: 'scale(1.14) rotate(5deg)', opacity: 1, offset: 0.7 },
              { transform: 'none', opacity: 1 },
            ],
            opciones(520, i * 60)
          )
        );
        g.querySelector('[data-centro]')!.animate(
          [{ transform: 'scale(0)' }, { transform: 'scale(1.25)', offset: 0.6 }, { transform: 'none' }],
          opciones(380, 5 * 60 + 80)
        );
      },
      lazos(g) {
        g.querySelector('[data-bucles]')!.animate(
          [
            { transform: 'scale(0) rotate(-25deg)' },
            { transform: 'scale(1.16) rotate(4deg)', offset: 0.65 },
            { transform: 'none' },
          ],
          opciones(480)
        );
        g.querySelectorAll('.cola').forEach((p) =>
          p.animate([{ strokeDasharray: '1 1', strokeDashoffset: 1 }, { strokeDasharray: '1 1', strokeDashoffset: 0 }], {
            ...opciones(520, 240, 'cubic-bezier(0.3, 0.6, 0.3, 1)'),
            fill: 'both',
          })
        );
        g.querySelectorAll('[data-nudito]').forEach((p) =>
          p.animate([{ opacity: 0 }, { opacity: 1 }], opciones(160, 700))
        );
      },
      flecos(g) {
        g.querySelectorAll('[data-an]').forEach((p, i) =>
          p.animate(
            [
              { transform: 'rotate(16deg) scaleY(0.1)', opacity: 0 },
              { transform: 'rotate(-7deg) scaleY(1.05)', opacity: 1, offset: 0.34 },
              { transform: 'rotate(4deg) scaleY(1)', offset: 0.58 },
              { transform: 'rotate(-1.5deg)', offset: 0.8 },
              { transform: 'none', opacity: 1 },
            ],
            opciones(950, i * 26, 'ease-out')
          )
        );
      },
      monedero(g) {
        g.querySelector('[data-an]')!.animate(
          [
            { transform: 'translate(48px, -18px) rotate(24deg)', opacity: 0 },
            { transform: 'translate(-3px, 1px) rotate(-4deg)', opacity: 1, offset: 0.62 },
            { transform: 'translate(1px, 0) rotate(1.5deg)', offset: 0.82 },
            { transform: 'none', opacity: 1 },
          ],
          opciones(640)
        );
      },
      bolsillo() {
        // Se cose de izquierda a derecha: el recorte que lo deja ver se va abriendo.
        const r = el.barrido;
        animar(
          'bolsillo',
          520,
          (t) => set(r, { width: 120 * salida(t) }),
          () => set(r, { width: 120 })
        );
      },
    };

    /** Al quitarse, cada detalle se recoge por donde entró, y más deprisa. */
    const salidas: Record<string, [string, Keyframe[]]> = {
      flor: ['[data-petalo], [data-centro]', [{ transform: 'none' }, { transform: 'scale(0.3) rotate(50deg)' }]],
      lazos: ['[data-bucles]', [{ transform: 'none' }, { transform: 'scale(0.4)' }]],
      flecos: ['[data-an]', [{ transform: 'none' }, { transform: 'scaleY(0.15)' }]],
      monedero: ['[data-an]', [{ transform: 'none' }, { transform: 'translate(34px, -10px) rotate(16deg)' }]],
    };

    function mostrarExtra(id: string, animado: boolean) {
      const g = el.extras[id];
      if (!g) return;
      cancelar(g);
      g.setAttribute('data-visible', '');
      if (id === 'bolsillo') set(el.barrido, { width: 120 });
      if (!animado) return;
      if (quieto.matches) {
        g.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
        return;
      }
      entradas[id]?.(g);
    }

    function ocultarExtra(id: string, animado: boolean) {
      const g = el.extras[id];
      if (!g) return;
      cancelar(g);
      if (!animado) {
        g.removeAttribute('data-visible');
        return;
      }
      const opc = { duration: 200, easing: 'ease-in', fill: 'forwards' as FillMode };
      const anims = [g.animate([{ opacity: 1 }, { opacity: 0 }], opc)];
      const salida = salidas[id];
      if (salida && !quieto.matches) {
        g.querySelectorAll(salida[0]).forEach((p) => anims.push(p.animate(salida[1], opc)));
      }
      anims[0]!.finished
        .then(() => {
          g.removeAttribute('data-visible');
          for (const a of anims) a.cancel();
        })
        .catch(() => {});
    }

    /** Al entrar en pantalla, el bolso se teje: vuelta a vuelta desde la base hasta el asa. */
    function tejerEntrada() {
      vivo = true;
      if (quieto.matches) {
        set(el.tejer, { y: 0, height: 310 });
        el.grupoSombra.setAttribute('opacity', '1');
        return;
      }
      const c = caja(mostrado);
      const tope = c.yT - Math.max(0, mostrado.asaAlto) * mostrado.asaVisible - mostrado.asaGrosor - 6;
      const inicio = c.yB + 6;
      const vueltas = Math.ceil((inicio - tope) / FILA);
      animar(
        'entrada',
        vueltas * 48,
        (t) => {
          const y = inicio - Math.floor(t * vueltas) * FILA;
          set(el.tejer, { y, height: 310 - y });
          el.grupoSombra.setAttribute('opacity', String(salida(Math.min(1, t * 1.6))));
          set(el.brillo, { y, opacity: y > c.yT - 2 ? 0.22 : 0 });
        },
        () => {
          set(el.tejer, { y: 0, height: 310 });
          el.brillo.setAttribute('opacity', '0');
          for (const id of extras) mostrarExtra(id, true);
        }
      );
    }

    // ------------------------------------------------------------------ leer el configurador

    function leer() {
      const f = svg.dataset.forma as FormaId;
      return {
        forma: f in FORMAS ? f : 'tote',
        extras: new Set((svg.dataset.extras ?? '').split(/\s+/).filter(Boolean)),
        tonos: (svg.dataset.tonos || '#B6B2AE').split(/\s+/).filter(Boolean),
      };
    }

    function actualizar() {
      const e = leer();
      const animado = vivo;

      if (e.forma !== formaId) {
        formaId = e.forma;
        if (animado) cambiarForma(formaId);
        else {
          mostrado = { ...FORMAS[formaId] };
          dibujar(mostrado);
        }
      }

      if (e.tonos.join(' ') !== tonos.join(' ')) {
        if (animado) cambiarColor(e.tonos);
        else {
          tonos = e.tonos;
          tonosViejos = e.tonos;
          hasta = 0;
          pintarLana();
          ponerTonos(false);
        }
      }

      let nuevo = false;
      for (const id of e.extras) {
        if (!extras.has(id)) {
          // Antes de tejerse, los detalles esperan: entran cuando el bolso ya está hecho.
          if (vivo) mostrarExtra(id, animado);
          nuevo = true;
        }
      }
      for (const id of extras) if (!e.extras.has(id)) ocultarExtra(id, animado);
      if (nuevo && animado && !(e.extras.size === 1 && e.extras.has('forro'))) asentar();
      extras = e.extras;
      if (!vivo) for (const id of extras) mostrarExtra(id, false);
    }

    // Arranque: se dibuja lo que ya haya puesto el configurador, sin animar, y el bolso
    // se esconde para tejerse cuando se vea. Sin movimiento pedido, se queda como está.
    dibujar(mostrado);
    actualizar();
    new MutationObserver(actualizar).observe(svg, {
      attributes: true,
      attributeFilter: ['data-forma', 'data-extras', 'data-tonos'],
    });

    if (quieto.matches || !('IntersectionObserver' in window)) {
      vivo = true;
    } else {
      for (const id of extras) el.extras[id]?.removeAttribute('data-visible');
      set(el.tejer, { y: 310, height: 0 });
      el.grupoSombra.setAttribute('opacity', '0');
      const io = new IntersectionObserver(
        (entradas) => {
          if (entradas.some((e) => e.isIntersecting)) {
            io.disconnect();
            tejerEntrada();
          }
        },
        { threshold: 0.4 }
      );
      io.observe(svg);
    }
  }
</script>
