---
/**
 * La ventana con el código QR para escribir a Sakina por WhatsApp.
 *
 * Cualquier enlace con `data-whatsapp` (el icono del pie y del menú, «Pregúntame por
 * WhatsApp» del configurador) la abre en vez de ir directo a WhatsApp, pero solo en
 * ordenador y tablet. Ahí, sin la app, el enlace se queda en la pantalla del código de
 * WhatsApp Web, que para quien no sabe qué es eso es un callejón sin salida. Con el QR
 * se escanea con el móvil y se abre la conversación ahí, con el mensaje ya escrito.
 * Quien sí tiene WhatsApp en ese aparato tiene el botón para abrirlo igual.
 *
 * En el móvil el enlace sigue yendo directo: ahí abre la app sin más, y un QR en la
 * misma pantalla no se podría escanear. Es la misma regla que el QR del pedido.
 */
---

<dialog data-qr-whatsapp class="ventana" aria-labelledby="qr-whatsapp-titulo">
  <button type="button" class="cerrar" data-cerrar-qr>
    <span class="sr-only">Cerrar</span>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M5 5l14 14M19 5L5 19"></path>
    </svg>
  </button>

  <h2 id="qr-whatsapp-titulo" class="font-display text-[1.75rem] leading-tight">
    Escríbeme por WhatsApp
  </h2>
  <p class="mt-3 text-[15px] text-ink-soft">
    Escanea el código con la cámara del móvil: se abre la conversación con el mensaje ya
    escrito.
  </p>
  <div class="caja" data-qr-whatsapp-caja></div>
  <a class="boton w-full" data-qr-whatsapp-abrir href="#" target="_blank" rel="noopener">
    Abrir WhatsApp aquí
  </a>
</dialog>

<style>
  .ventana {
    width: min(22rem, calc(100vw - 2rem));
    margin: auto;
    padding: 2rem 1.75rem 1.75rem;
    border: 0;
    border-radius: 14px;
    background-color: var(--color-paper);
    color: var(--color-ink);
    text-align: center;
    box-shadow: 0 1.5rem 4rem rgb(31 29 27 / 0.3);
  }
  .cerrar {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
  }
  .cerrar:hover {
    background-color: color-mix(in srgb, var(--color-line) 30%, transparent);
  }
  .caja {
    width: 13rem;
    margin: 1.4rem auto 1.5rem;
    background-color: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  /* El SVG lo mete el script, así que no lleva el atributo de Astro de este bloque. */
  .caja :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script>
  import qrcode from 'qrcode-generator';

  // Los mensajes llevan tildes y la «ñ»: sin esto la librería los codifica mal.
  qrcode.stringToBytes = (s: string) => Array.from(new TextEncoder().encode(s));

  const ventana = document.querySelector<HTMLDialogElement>('[data-qr-whatsapp]');
  const caja = document.querySelector<HTMLElement>('[data-qr-whatsapp-caja]');
  const abrir = document.querySelector<HTMLAnchorElement>('[data-qr-whatsapp-abrir]');

  // Ordenador (ratón) o tablet (grande en las dos direcciones). Igual que en el pedido.
  const conQr = window.matchMedia(
    '(hover: hover) and (pointer: fine), (min-width: 700px) and (min-height: 600px)',
  );

  if (ventana && caja && abrir) {
    document.addEventListener('click', (e) => {
      const enlace = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-whatsapp]');
      if (!enlace || !conQr.matches) return;
      // Ctrl/Cmd+clic y compañía: quien los usa sabe lo que quiere.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();

      const qr = qrcode(0, 'M');
      qr.addData(enlace.href);
      qr.make();
      caja.innerHTML = qr.createSvgTag({ scalable: true });
      abrir.href = enlace.href;
      ventana.showModal();
    });

    ventana.querySelector('[data-cerrar-qr]')?.addEventListener('click', () => ventana.close());
    abrir.addEventListener('click', () => ventana.close());
    // Pulsar fuera de la ventana la cierra. Por posición y no por `e.target`: el
    // relleno de la propia ventana también cuenta como la ventana.
    ventana.addEventListener('click', (e) => {
      const r = ventana.getBoundingClientRect();
      const fuera =
        e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      if (fuera) ventana.close();
    });
  }
</script>
