---
import { SECCIONES } from '../data/navegacion';
import Marca from './Marca.astro';
import Redes from './Redes.astro';
import site from '../data/site.json';

const ano = new Date().getFullYear();
---

<footer class="oscuro px-5 py-section sm:px-8">
  <div class="mx-auto grid max-w-7xl gap-x-12 gap-y-12 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Marca claro class="w-[min(15rem,60vw)]" sizes="15rem" />
      <p class="mt-3 max-w-[38ch] text-paper/70">
        Bolsos de ganchillo y lino cosido a mano. Piezas únicas, hechas de una en una.
      </p>
    </div>

    <nav aria-label="Secciones">
      <h2 class="font-sans text-[15px] tracking-normal text-paper/60">La web</h2>
      <ul class="mt-3 grid gap-2">
        {
          SECCIONES.map((s) => (
            <li>
              <a href={s.href} class="no-underline hover:underline">
                {s.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-[15px] tracking-normal text-paper/60">Escríbeme</h2>
      <div class="mt-4"><Redes claro /></div>
      <p class="mt-4 max-w-[30ch] text-[15px] text-paper/60">
        Lo más rápido es WhatsApp: Sakina contesta ella misma.
      </p>
    </div>
  </div>

  <div
    class="mx-auto mt-16 flex max-w-7xl flex-wrap gap-x-8 gap-y-2 border-t border-paper/20 pt-6 text-[14px] text-paper/50"
  >
    <p>© {ano} {site.marca}</p>
    <p>Hecho a mano en España.</p>
  </div>
</footer>
