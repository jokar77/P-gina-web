---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import firma from '../assets/marca/firma.png';
import site from '../data/site.json';

const parrafos = site.taller.texto.split('\n\n');

/**
 * El collage de polaroids junto al texto: fotos de piezas sueltas sobre la mesa, algo
 * giradas y montadas unas sobre otras, con una foto más grande en medio.
 *
 * Las fotos las elige Sakina en Pages CMS («Collage de "Sobre mí"»): una del centro y
 * hasta ocho alrededor, que van cayendo en estos huecos por orden. El orden de los
 * huecos está pensado para que con menos fotos también quede equilibrado: primero las
 * cuatro esquinas, luego los de en medio.
 *
 * `x` e `y` son el centro de la polaroid, en % del hueco; `alto` es el alto de la foto
 * en % del alto del hueco. Así el collage mantiene su composición sea cual sea el alto
 * del texto de al lado, que es el que manda. Si el hueco sale casi cuadrado (pantallas
 * medianas), las fotos encogen un poco para no taparse unas a otras.
 */
const HUECOS = [
  { x: 15, y: 25, alto: 36, giro: -6 },
  { x: 87, y: 69, alto: 35, giro: -4 },
  { x: 86, y: 27, alto: 36, giro: 6 },
  { x: 13, y: 70, alto: 36, giro: 5 },
  { x: 33, y: 17, alto: 31, giro: 4 },
  { x: 69, y: 84, alto: 32, giro: 4 },
  { x: 67, y: 16, alto: 33, giro: -3 },
  { x: 31, y: 84, alto: 31, giro: -5 },
];
const CENTRO = { x: 50, y: 50, alto: 60, giro: -2 };

/**
 * Si la foto elegida es de una pieza (la misma imagen que usa su ficha), la polaroid
 * lleva a esa pieza y toma su nombre para el texto alternativo. Una foto subida aparte
 * sale igual, sin enlace.
 */
const piezas = [
  ...(await getCollection('bolsos')).map((p) => ({ ...p, ruta: 'bolsos' })),
  ...(await getCollection('ninos')).map((p) => ({ ...p, ruta: 'ninos' })),
  ...(await getCollection('archivo')).map((p) => ({ ...p, ruta: 'archivo' })),
];
const dePieza = (foto: ImageMetadata) =>
  piezas.find((p) => [p.data.foto, ...p.data.fotos].some((f) => f.src === foto.src));

const datos = (await getCollection('collage'))[0]?.data;
const elegidas = datos
  ? [
      ...datos.fotos.slice(0, HUECOS.length).map((foto, i) => ({ foto, ...HUECOS[i]! })),
      // El centro va el último para quedar encima de todas.
      { foto: datos.central, ...CENTRO },
    ]
  : [];
const collage = elegidas.map((c) => {
  const pieza = dePieza(c.foto);
  return {
    ...c,
    nombre: pieza?.data.nombre ?? 'Una pieza del taller',
    href: pieza ? `/${pieza.ruta}/${pieza.id}` : undefined,
  };
});
---

<section id="taller" class="scroll-mt-20 px-5 py-section sm:px-8">
  <div class="taller mx-auto max-w-7xl">
    <div class="max-w-[62ch]">
      <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)]">{site.taller.titulo}</h2>
      {parrafos.map((p) => <p class="mt-5 text-lg">{p}</p>)}

      <Image
        src={firma}
        alt="Firmado, Sakina."
        widths={[220, 440]}
        sizes="13rem"
        class="mt-8 h-auto w-[13rem]"
        loading="lazy"
      />
    </div>

    {
      collage.length > 0 && (
        <ul class="collage" aria-label="Algunas piezas del taller">
          {collage.map((c, i) => (
            <li
              class="polaroid"
              style={`--x:${c.x}%;--y:${c.y}%;--alto:${c.alto};--giro:${c.giro}deg;--capa:${i + 1}`}
            >
              <a href={c.href}>
                <Image
                  src={c.foto}
                  alt={c.nombre}
                  widths={[240, 480, 720]}
                  sizes={c.alto > 50 ? '(min-width: 1024px) 18rem, 45vw' : '(min-width: 1024px) 10rem, 25vw'}
                  loading="lazy"
                />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .taller {
    display: grid;
    gap: 3rem;
  }
  /*
   * En pantalla ancha, el collage ocupa la columna de al lado y se estira al alto del
   * texto: la contención de tamaño hace que no cuente para el alto de la fila (lo marca
   * el texto) y que sus fotos se midan contra el hueco que le queda (`cqh`).
   */
  @media (min-width: 1024px) {
    .taller {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: stretch;
    }
  }

  .collage {
    position: relative;
    container-type: size;
    aspect-ratio: 5 / 4;
    /* En el móvil va a todo el ancho de la pantalla: con los márgenes, las fotos quedaban
       demasiado pequeñas. */
    margin: 0 -1.25rem;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .collage {
      aspect-ratio: auto;
      min-height: 26rem;
      margin: 0;
    }
  }

  .polaroid {
    /* La unidad de todo el collage: el 1 % del alto, salvo que el hueco sea estrecho. */
    --u: min(1cqh, 0.72cqw);
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: var(--capa);
    transform: translate(-50%, -50%) rotate(var(--giro));
    transition: transform 320ms var(--ease-salida);
  }
  .polaroid a {
    display: block;
    padding: calc(1.3 * var(--u)) calc(1.3 * var(--u)) calc(4.2 * var(--u));
    background-color: #faf8f3;
    box-shadow:
      0 calc(0.3 * var(--u)) calc(0.6 * var(--u)) rgb(31 29 27 / 0.14),
      0 calc(1.4 * var(--u)) calc(3 * var(--u)) rgb(31 29 27 / 0.2);
    transition: box-shadow 320ms var(--ease-salida);
  }
  .polaroid img {
    display: block;
    height: calc(var(--alto) * var(--u));
    width: calc(var(--alto) * 0.75 * var(--u));
    object-fit: cover;
  }

  /*
   * Al pasar por encima, la polaroid se endereza y se levanta un poco sobre las demás:
   * dice que se puede pulsar (lleva a la pieza) sin que el collage se mueva entero.
   */
  @media (hover: hover) and (pointer: fine) {
    .polaroid:hover {
      z-index: 50;
      transform: translate(-50%, -50%) rotate(0deg) scale(1.06);
    }
    .polaroid:hover a {
      box-shadow:
        0 calc(0.4 * var(--u)) calc(0.8 * var(--u)) rgb(31 29 27 / 0.16),
        0 calc(2.4 * var(--u)) calc(5 * var(--u)) rgb(31 29 27 / 0.28);
    }
  }
  .polaroid a:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .polaroid:has(a:focus-visible) {
    z-index: 50;
  }
  @media (prefers-reduced-motion: reduce) {
    .polaroid,
    .polaroid a {
      transition: none;
    }
  }
</style>
