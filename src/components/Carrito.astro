---
/**
 * Panel del pedido. Reúne las piezas y las entrega escritas por WhatsApp: no cobra.
 * Vive en el layout, así que cualquier página puede añadir con un botón [data-anadir].
 *
 * Va en dos pantallas, no una sola larga: primero el resumen de piezas, y solo si se
 * pulsa «Comprar» aparecen el envío, los datos y el botón de WhatsApp. Todo junto no
 * cabía bien en un móvil —piezas, envío, total y el aviso se peleaban por el sitio—, y
 * separarlo también deja claro que hay un paso más antes de mandar el mensaje.
 *
 * Los datos de envío se escriben aquí solo para redactar el mensaje. No se guardan en
 * ningún sitio —ni en el navegador ni en un servidor—: van directos al texto que se
 * manda por WhatsApp, igual que si se hubieran tecleado allí.
 */
import { METODOS } from '../lib/envio';
import site from '../data/site.json';
import { precio } from '../lib/formato';
---

<dialog
  data-carrito
  class="oscuro m-0 ml-auto h-dvh max-h-none w-full max-w-[28rem] p-0"
  aria-label="Tu pedido"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center gap-3 px-6 pt-7 pb-5">
      <button
        type="button"
        class="-ml-2 px-2 py-2.5 text-[15px] underline"
        data-volver
        hidden
        aria-label="Volver al resumen del pedido"
      >
        ← Volver
      </button>
      <h2 class="font-display text-2xl" data-carrito-titulo>Tu pedido</h2>
      <button type="button" class="-mr-2 ml-auto px-2 py-2.5 text-[15px] underline" data-cerrar-carrito>
        Cerrar
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-6" data-carrito-scroll>
      <p class="pb-6 text-[15px] text-paper/70" data-carrito-vacio>
        Todavía no has añadido nada. Cada pieza es única: cuando añadas una, aquí verás el
        resumen que le llega a Sakina.
      </p>

      <div data-paso-lista>
        <ul data-carrito-lista></ul>
      </div>

      <form hidden data-paso-datos>
        <fieldset>
          <legend class="text-[15px] text-paper/70">Cómo lo recibes</legend>
          <div class="mt-3 grid gap-2">
            {
              METODOS.map((m, i) => (
                <label class="opcion-envio">
                  <input
                    type="radio"
                    name="envio"
                    value={m.id}
                    checked={i === 0}
                    class="sr-only"
                    data-metodo
                  />
                  <span class="marca-radio" aria-hidden="true" />
                  <span class="flex-1">{m.nombre}</span>
                  <span class="text-paper/60">{precio(m.precio)}</span>
                </label>
              ))
            }
          </div>
          <p class="mt-2 text-[14px] text-paper/55">
            Gratis a partir de {precio(site.envios.gratisDesde)}. {site.envios.zona}.
          </p>
        </fieldset>

        <fieldset class="filete-envio mt-7 pt-6">
          <legend class="text-[15px] text-paper/70">Dónde te lo mandamos</legend>
          <p class="mt-1 mb-4 text-[14px] text-paper/55" data-envio-nota></p>
          <div class="grid gap-3">
            <label class="campo">
              <span>Nombre y apellidos</span>
              <input type="text" name="nombre" autocomplete="name" data-dato />
            </label>
            <label class="campo">
              <span>Dirección</span>
              <input
                type="text"
                name="direccion"
                autocomplete="street-address"
                placeholder="Calle, número, piso"
                data-dato
              />
            </label>
            <div class="grid grid-cols-[7rem_1fr] gap-3">
              <label class="campo">
                <span>Código postal</span>
                <input type="text" name="cp" inputmode="numeric" autocomplete="postal-code" data-dato />
              </label>
              <label class="campo">
                <span>Población</span>
                <input type="text" name="poblacion" autocomplete="address-level2" data-dato />
              </label>
            </div>
          </div>
        </fieldset>

        <dl class="filete-envio mt-7 grid grid-cols-[1fr_auto] gap-y-1 pt-6 text-[15px]">
          <dt class="text-paper/70">Piezas</dt>
          <dd class="text-right" data-carrito-subtotal-datos></dd>
          <dt class="text-paper/70">Envío</dt>
          <dd class="text-right" data-carrito-coste-envio></dd>
          <dt class="mt-1 self-baseline">Total</dt>
          <dd class="mt-1 text-right font-display text-2xl" data-carrito-total></dd>
        </dl>

        <p class="mt-1 text-[13px] text-paper/60" data-carrito-aviso hidden>
          Orientativo: las piezas por encargo se cierran hablando.
        </p>

        <p class="mt-4 pb-6 text-[14px] text-paper/70">
          Aquí no se paga nada. Al pulsar se abre WhatsApp con este pedido escrito, y el pago
          lo acordáis por Bizum o transferencia. No se envía a Canarias, Ceuta ni Melilla.
        </p>
      </form>
    </div>

    <div class="border-t border-paper/20 px-6 py-5" data-carrito-pie hidden>
      <div data-pie-lista>
        <dl class="grid grid-cols-[1fr_auto] gap-y-1 text-[15px]">
          <dt class="text-paper/70">Piezas</dt>
          <dd class="text-right" data-carrito-subtotal></dd>
        </dl>

        <a class="boton boton-claro mt-4 w-full" data-ir-datos href="#">Comprar</a>
        <button type="button" class="boton mt-2 w-full border border-paper/30" data-seguir>
          Seguir mirando
        </button>
        <button type="button" class="mt-2 w-full py-3 text-[14px] underline" data-carrito-vaciar>
          Vaciar el pedido
        </button>
      </div>

      <div data-pie-datos hidden>
        <a class="boton boton-claro w-full" data-carrito-enviar href="#">Enviar por WhatsApp</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog[data-carrito] {
    border: 0;
    transform: translateX(100%);
    transition:
      transform 340ms var(--ease-salida),
      overlay 340ms allow-discrete,
      display 340ms allow-discrete;
  }
  dialog[data-carrito][open] {
    transform: translateX(0);
  }
  @starting-style {
    dialog[data-carrito][open] {
      transform: translateX(100%);
    }
  }

  .opcion-envio {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    cursor: pointer;
    padding: 10px 12px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 22%, transparent);
    transition: box-shadow 180ms var(--ease-salida);
  }
  .opcion-envio:has(input:checked) {
    box-shadow: inset 0 0 0 1px var(--color-paper);
  }
  .opcion-envio:has(input:focus-visible) {
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }
  .marca-radio {
    width: 16px;
    height: 16px;
    flex: none;
    border-radius: 9999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 55%, transparent);
    transition: box-shadow 180ms var(--ease-salida);
  }
  .opcion-envio:has(input:checked) .marca-radio {
    box-shadow:
      inset 0 0 0 1px var(--color-paper),
      inset 0 0 0 5px var(--color-deep),
      inset 0 0 0 16px var(--color-paper);
  }

  /* El filete va por encima del fieldset entero, no partido por su propio título:
     un <legend> se sienta sobre el borde y lo corta por la mitad. */
  .filete-envio {
    position: relative;
  }
  .filete-envio::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 20%, transparent);
  }

  .campo {
    display: grid;
    gap: 5px;
  }
  .campo > span {
    font-size: 14px;
    color: color-mix(in srgb, var(--color-paper) 70%, transparent);
  }
  .campo input {
    width: 100%;
    padding: 10px 12px;
    background-color: transparent;
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 30%, transparent);
    transition: box-shadow 180ms var(--ease-salida);
  }
  .campo input::placeholder {
    color: color-mix(in srgb, var(--color-paper) 60%, transparent);
  }
  .campo input:hover {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-paper) 50%, transparent);
  }
  .campo input:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--color-paper);
  }
</style>

<script>
  import { anadir, contiene, hayOrientativos, leer, quitar, suscribir, total, vaciar } from '../lib/carrito';
  import type { Linea } from '../lib/carrito';
  import { costeEnvio, nombreMetodo, type Metodo } from '../lib/envio';
  import { precio } from '../lib/formato';
  import site from '../data/site.json';

  type Paso = 'lista' | 'datos';

  const panel = document.querySelector<HTMLDialogElement>('[data-carrito]');
  const scroll = document.querySelector<HTMLElement>('[data-carrito-scroll]');
  const titulo = document.querySelector<HTMLElement>('[data-carrito-titulo]');
  const volver = document.querySelector<HTMLButtonElement>('[data-volver]');
  const lista = document.querySelector<HTMLUListElement>('[data-carrito-lista]');
  const pie = document.querySelector<HTMLElement>('[data-carrito-pie]');
  const pasoLista = document.querySelector<HTMLElement>('[data-paso-lista]');
  const pasoDatos = document.querySelector<HTMLFormElement>('[data-paso-datos]');
  const pieLista = document.querySelector<HTMLElement>('[data-pie-lista]');
  const pieDatos = document.querySelector<HTMLElement>('[data-pie-datos]');
  const vacio = document.querySelector<HTMLElement>('[data-carrito-vacio]');
  const marcaSubtotal = document.querySelector<HTMLElement>('[data-carrito-subtotal]');
  const marcaSubtotalDatos = document.querySelector<HTMLElement>('[data-carrito-subtotal-datos]');
  const marcaEnvio = document.querySelector<HTMLElement>('[data-carrito-coste-envio]');
  const marcaTotal = document.querySelector<HTMLElement>('[data-carrito-total]');
  const aviso = document.querySelector<HTMLElement>('[data-carrito-aviso]');
  const notaEnvio = document.querySelector<HTMLElement>('[data-envio-nota]');
  const irDatos = document.querySelector<HTMLAnchorElement>('[data-ir-datos]');
  const enviar = document.querySelector<HTMLAnchorElement>('[data-carrito-enviar]');

  let paso: Paso = 'lista';

  function mostrarPaso(p: Paso) {
    paso = p;
    if (pasoLista) pasoLista.hidden = p !== 'lista';
    if (pasoDatos) pasoDatos.hidden = p !== 'datos';
    if (pieLista) pieLista.hidden = p !== 'lista';
    if (pieDatos) pieDatos.hidden = p !== 'datos';
    if (volver) volver.hidden = p !== 'datos';
    if (titulo) titulo.textContent = p === 'datos' ? 'Datos de envío' : 'Tu pedido';
    scroll?.scrollTo(0, 0);
  }

  const metodoElegido = (): Metodo =>
    (document.querySelector<HTMLInputElement>('[data-metodo]:checked')?.value as Metodo) ??
    'recogida';

  const dato = (nombre: string) =>
    document.querySelector<HTMLInputElement>(`[data-dato][name="${nombre}"]`)?.value.trim() ?? '';

  /** Las piezas de catálogo se compran tal cual; las de encargo son una consulta que se
   *  cierra hablando. Solo a las primeras les hacen falta los datos de envío ya. */
  const requiereDatos = (lineas: Linea[]) => lineas.some((l) => !l.orientativo);

  function mensaje(lineas: Linea[]) {
    const piezas = total();
    const metodo = metodoElegido();
    const envioCoste = costeEnvio(piezas, metodo);

    const cuerpo = lineas
      .map((l) => {
        const cabeza = `· ${l.nombre} — ${precio(l.precio)}${l.orientativo ? ' (orientativo)' : ''}`;
        return l.detalle ? `${cabeza}\n  ${l.detalle}` : cabeza;
      })
      .join('\n');

    const partes = [
      'Hola Sakina, me gustaría encargar:',
      '',
      cuerpo,
      '',
      `Envío (${nombreMetodo(metodo).toLowerCase()}): ${envioCoste === 0 ? 'gratis' : precio(envioCoste)}`,
      `Total: ${precio(piezas + envioCoste)}${hayOrientativos() ? ' (orientativo)' : ''}`,
    ];

    // Los datos de envío solo se añaden si se han escrito.
    const direccion = [
      dato('nombre'),
      dato('direccion'),
      [dato('cp'), dato('poblacion')].filter(Boolean).join(' '),
    ].filter(Boolean);

    if (direccion.length) partes.push('', 'Mis datos:', ...direccion);

    return partes.join('\n');
  }

  function pintar(lineas: Linea[]) {
    const cuenta = document.querySelector<HTMLElement>('[data-cuenta-carrito]');
    const cuentaTexto = document.querySelector<HTMLElement>('[data-cuenta-texto]');
    if (cuenta) {
      cuenta.textContent = String(lineas.length);
      cuenta.hidden = lineas.length === 0;
    }
    if (cuentaTexto) {
      cuentaTexto.textContent =
        lineas.length === 0 ? 'vacío' : lineas.length === 1 ? '1 pieza' : `${lineas.length} piezas`;
    }

    for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-anadir]')) {
      const linea = JSON.parse(boton.dataset.anadir!) as Linea;
      const dentro = contiene(linea.id);
      boton.textContent = dentro ? 'Quitar del pedido' : (boton.dataset.etiqueta ?? 'Añadir al pedido');
      boton.dataset.dentro = String(dentro);
    }

    if (!lista || !pie || !vacio || !marcaTotal || !enviar || !pasoDatos) return;

    lista.replaceChildren(
      ...lineas.map((l) => {
        const li = document.createElement('li');
        li.className = 'flex gap-4 border-b border-paper/15 py-4 last:border-0';

        const texto = document.createElement('div');
        texto.className = 'flex-1';

        const nombre = document.createElement('p');
        nombre.className = 'font-display text-lg';
        nombre.textContent = l.nombre;
        texto.append(nombre);

        if (l.detalle) {
          const det = document.createElement('p');
          det.className = 'mt-0.5 text-[14px] text-paper/65';
          det.textContent = l.detalle;
          texto.append(det);
        }

        const derecha = document.createElement('div');
        derecha.className = 'flex flex-col items-end gap-2';

        const p = document.createElement('span');
        p.className = 'whitespace-nowrap';
        p.textContent = precio(l.precio) + (l.orientativo ? ' *' : '');
        derecha.append(p);

        const fuera = document.createElement('button');
        fuera.type = 'button';
        fuera.className = '-mr-1 px-1 py-2 text-[14px] text-paper/65 underline hover:text-paper';
        fuera.textContent = 'Quitar';
        fuera.setAttribute('aria-label', `Quitar ${l.nombre} del pedido`);
        fuera.addEventListener('click', () => quitar(l.id));
        derecha.append(fuera);

        li.append(texto, derecha);
        return li;
      })
    );

    const hay = lineas.length > 0;
    pie.hidden = !hay;
    vacio.hidden = hay;
    // Sin piezas no hay nada que comprar ni que consultar: de vuelta al resumen.
    if (!hay && paso === 'datos') mostrarPaso('lista');

    const necesitaDatos = requiereDatos(lineas);
    for (const campo of ['nombre', 'direccion', 'cp', 'poblacion']) {
      const input = document.querySelector<HTMLInputElement>(`[data-dato][name="${campo}"]`);
      if (input) input.required = necesitaDatos;
    }
    if (notaEnvio) {
      notaEnvio.textContent = necesitaDatos
        ? 'Estas piezas se compran tal cual, así que rellena estos datos: así Sakina prepara el envío sin tener que preguntártelos por WhatsApp.'
        : 'Esto es una consulta —el precio y los detalles se cierran hablando—, así que puedes dejarlo en blanco y lo acordáis por WhatsApp.';
    }

    const piezas = total();
    const envioCoste = costeEnvio(piezas, metodoElegido());
    if (marcaSubtotal) marcaSubtotal.textContent = precio(piezas);
    if (marcaSubtotalDatos) marcaSubtotalDatos.textContent = precio(piezas);
    if (marcaEnvio) marcaEnvio.textContent = envioCoste === 0 ? 'Gratis' : precio(envioCoste);
    marcaTotal.textContent = precio(piezas + envioCoste);
    if (aviso) aviso.hidden = !hayOrientativos();

    enviar.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(mensaje(lineas))}`;
  }

  suscribir(pintar);

  // Cambiar de método de envío o escribir la dirección rehace el mensaje y el total.
  panel?.addEventListener('change', () => pintar(leer()));
  panel?.addEventListener('input', () => pintar(leer()));
  // Con un único campo de texto, Enter dispara el envío nativo del <form>: lo evitamos,
  // que aquí «enviar» significa abrir WhatsApp, no recargar la página.
  pasoDatos?.addEventListener('submit', (e) => e.preventDefault());

  irDatos?.addEventListener('click', (e) => {
    e.preventDefault();
    mostrarPaso('datos');
  });
  volver?.addEventListener('click', () => mostrarPaso('lista'));

  enviar?.addEventListener('click', (e) => {
    if (pasoDatos && !pasoDatos.reportValidity()) e.preventDefault();
  });

  document.addEventListener('click', (e) => {
    const boton = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-anadir]');
    if (!boton) return;
    const linea = JSON.parse(boton.dataset.anadir!) as Linea;
    if (contiene(linea.id)) {
      quitar(linea.id);
    } else {
      anadir(linea);
      mostrarPaso('lista');
      panel?.showModal();
    }
  });

  for (const b of document.querySelectorAll('[data-abrir-carrito]')) {
    b.addEventListener('click', () => {
      mostrarPaso('lista');
      panel?.showModal();
    });
  }
  document.querySelector('[data-cerrar-carrito]')?.addEventListener('click', () => panel?.close());
  document.querySelector('[data-seguir]')?.addEventListener('click', () => panel?.close());
  // Vaciar es destructivo y no hay deshacer, así que pide confirmación en el propio
  // botón. La pregunta se retira sola: no deja el panel en un estado raro.
  const botonVaciar = document.querySelector<HTMLButtonElement>('[data-carrito-vaciar]');
  if (botonVaciar) {
    const ETIQUETA = botonVaciar.textContent!.trim();
    let confirmando: ReturnType<typeof setTimeout> | undefined;

    const reponer = () => {
      clearTimeout(confirmando);
      confirmando = undefined;
      botonVaciar.textContent = ETIQUETA;
    };

    botonVaciar.addEventListener('click', () => {
      if (confirmando) {
        reponer();
        vaciar();
        return;
      }
      botonVaciar.textContent = '¿Seguro? Pulsa otra vez para vaciarlo';
      confirmando = setTimeout(reponer, 4000);
    });
  }

  panel?.addEventListener('click', (e) => {
    if (e.target === panel) panel.close();
  });

  pintar(leer());
</script>
