---
/**
 * Obra hecha que no está a la venta.
 *
 * No es otra categoría de producto: es la prueba de lo que sabe hacer. Un vestido de
 * flamenca no se parece en nada a un bolso de trapillo, y meterlos en la misma rejilla
 * que los bolsos los convertiría a los dos en catálogo. Por eso van aparte, en su propia
 * sección, con el tipo de cada pieza escrito debajo de su foto en vez de un precio.
 *
 * Todas las piezas van en la misma rejilla, una junto a otra, aunque sean de tipos
 * distintos: separarlas en una fila por tipo dejaba una pieza sola colgando debajo de
 * la otra en cuanto había pocas, que es justo lo que hay al principio.
 *
 * Sin precio y sin botón de comprar. Se puede preguntar, y preguntar entra en el mismo
 * pedido que todo lo demás, como ya pasa con los bolsos vendidos.
 *
 * Si no hay ninguna pieza, la sección no existe. Una sección vacía en una web publicada
 * es peor que no tenerla.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const piezas = (await getCollection('archivo')).sort((a, b) => a.data.orden - b.data.orden);

const seccion = site.secciones.archivo;
---

{
  piezas.length > 0 && (
    <section id="archivo" class="scroll-mt-20 bg-panel px-5 py-section sm:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
          <h2 class="font-display text-[clamp(2rem,5vw,3.25rem)]">{seccion.titulo}</h2>
          <p class="max-w-[52ch] text-ink-soft">{seccion.intro}</p>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-7 lg:grid-cols-3 lg:gap-x-9">
          {piezas.map((pieza) => (
            <li>
              <a href={`/archivo/${pieza.id}`} class="block no-underline">
                <Image
                  src={pieza.data.foto}
                  alt={`${pieza.data.nombre}, ${pieza.data.tipo.toLowerCase()}.`}
                  widths={[320, 640, 900]}
                  sizes="(min-width: 1024px) 22rem, (min-width: 640px) 40vw, 46vw"
                  class="aspect-[3/4] w-full bg-paper object-cover"
                  loading="lazy"
                />
                <p class="mt-3 text-[12px] tracking-[0.14em] text-ink-soft uppercase">
                  {pieza.data.tipo}
                </p>
                <div class="mt-1 flex items-baseline justify-between gap-3">
                  <span class="font-display text-lg">{pieza.data.nombre}</span>
                  {pieza.data.ano && (
                    <span class="text-[15px] text-ink-soft">{pieza.data.ano}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
