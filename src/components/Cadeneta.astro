---
/**
 * Una cadeneta del dibujo del bolso (ver Maqueta.astro): el asa, el remate de la boca,
 * el borde de la ranura, la solapa del monedero. Todas son lo mismo —una tira de granos
 * de trapillo sobre una línea—, pintadas en capas: contorno, fondo del color de la lana,
 * un oscurecido encima que hace de hueco entre grano y grano, y los granos con su sombra
 * y su brillo. El script de la maqueta las redibuja buscándolas por `data-cad`.
 */
import type { Cadeneta } from '../lib/maqueta';

interface Props {
  nombre: string;
  cad: Cadeneta;
  grosor: number;
  /** De qué lana: la principal (a) o la del remate y los adornos (b). */
  tono?: 'a' | 'b';
  /** Un filo claro por fuera, para que se vea sobre el panel oscuro lo que va al aire. */
  halo?: boolean;
}

const { nombre, cad, grosor, tono = 'b', halo = false } = Astro.props;
---

{halo && <path class="halo" data-cad={nombre} data-parte="halo" d={cad.linea} stroke-width={grosor + 4.5} />}
<path class="borde" data-cad={nombre} data-parte="borde" d={cad.linea} stroke-width={grosor + 2.6} />
<path class={`base base-${tono}`} data-cad={nombre} data-parte="base" d={cad.linea} stroke-width={grosor} />
<path class="hondo" data-cad={nombre} data-parte="hondo" d={cad.linea} stroke-width={grosor} />
<path class="sombra" data-cad={nombre} data-parte="sombra" d={cad.sombra} />
<path class={`grano grano-${tono}`} data-cad={nombre} data-parte="lana" d={cad.lana} />
<path class="luz" data-cad={nombre} data-parte="luz" d={cad.luz} />

<style>
  .halo,
  .borde,
  .base,
  .hondo {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .halo {
    stroke: rgb(255 255 255 / 0.12);
  }
  .borde {
    stroke: rgb(0 0 0 / 0.38);
  }
  .base-a {
    stroke: url(#lana-a);
  }
  .base-b {
    stroke: url(#lana-b);
  }
  .hondo {
    stroke: rgb(0 0 0 / 0.24);
  }
  .sombra {
    fill: rgb(0 0 0 / 0.3);
  }
  .grano-a {
    fill: url(#lana-a);
  }
  .grano-b {
    fill: url(#lana-b);
  }
  .luz {
    fill: rgb(255 255 255 / 0.22);
  }
</style>
