---
/**
 * Una familia en la portada: sus piezas juntas y la puerta a su página.
 *
 * Las piezas van recortadas y superpuestas, no en una cuadrícula. Una cuadrícula sería
 * el catálogo otra vez —y el catálogo está una página más allá—; amontonadas se leen
 * como lo que son, un montón de cosas hechas a mano, y caben todas en una pantalla.
 *
 * Solo entran las que tienen recorte. Una pieza con su fondo de manta metida entre
 * recortes se ve como un parche, así que es mejor que espere: sale igualmente en su
 * página desde el minuto uno.
 */
import { Image } from 'astro:assets';

interface Props {
  titulo: string;
  intro: string;
  href: string;
  enlace: string;
  piezas: { nombre: string; recorte: ImageMetadata }[];
  /** El primero de la página carga sin diferir: es lo que se ve al entrar. */
  primero?: boolean;
}

const { titulo, intro, href, enlace, piezas, primero = false } = Astro.props;
---

<section class:list={['puerta', primero && 'primera']}>
  <div class="mx-auto grid max-w-7xl gap-y-6">
    <div class="cabeza">
      <h2 class="font-display text-[clamp(1.9rem,4.4vw,3rem)]">{titulo}</h2>
      <p class="max-w-[46ch] text-ink-soft">{intro}</p>
    </div>

    <a class="monton" href={href} aria-label={enlace}>
      {
        piezas.map((p, i) => (
          <span class="pieza" style={`--i:${i}`}>
            <Image
              src={p.recorte}
              alt={p.nombre}
              widths={[180, 360, 540]}
              sizes="(min-width: 1024px) 15rem, 34vw"
              loading={primero && i < 4 ? 'eager' : 'lazy'}
            />
          </span>
        ))
      }
    </a>

    <a class="boton boton-linea justify-self-start" href={href}>{enlace}</a>
  </div>
</section>

<style>
  .puerta {
    padding: 3.5rem 1.25rem;
  }
  @media (min-width: 640px) {
    .puerta {
      padding: 4.5rem 2rem;
    }
  }
  /* La primera va pegada al nombre: es lo que hay que ver al entrar, sin bajar. */
  .primera {
    padding-top: 1.5rem;
  }

  .cabeza {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .cabeza {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      gap: 2.5rem;
    }
    .cabeza p {
      padding-bottom: 0.4rem;
    }
  }

  /*
   * El montón. Los márgenes negativos hacen que las piezas se solapen un poco, y el
   * tamaño y la inclinación varían por posición: sin eso se lee como una fila de iconos.
   * Todo sale del índice, así que la portada es igual en cada visita —nada se decide al
   * azar en el navegador, que daría un salto al cargar.
   */
  .monton {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 0;
    text-decoration: none;
  }

  /*
   * El tamaño está calibrado para que los doce bolsos quepan en una sola fila a 1280px,
   * que es el ancho del contenido. Un poco más grandes y el último se caía solo a una
   * segunda fila, que se lee como un error de maquetación y no como una composición.
   * Más grandes todavía se leía como un catálogo con las fotos hinchadas, y el catálogo
   * está una página más allá.
   */
  .pieza {
    display: block;
    width: clamp(3.6rem, 9vw, 6.4rem);
    margin-inline: -0.55rem;
    transition: transform 320ms var(--ease-salida);
  }
  .pieza:nth-child(3n + 1) {
    width: clamp(4.4rem, 11vw, 7.9rem);
    margin-bottom: 0.6rem;
  }
  .pieza:nth-child(4n + 3) {
    margin-bottom: 1.5rem;
  }
  .pieza:nth-child(5n + 2) {
    margin-bottom: -0.4rem;
  }
  .pieza img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 18px rgb(31 29 27 / 0.14));
  }

  /* Al señalar el montón, la pieza señalada se adelanta un poco: dice que se puede entrar. */
  @media (hover: hover) and (pointer: fine) {
    .monton:hover .pieza {
      transform: translateY(0.35rem) scale(0.97);
    }
    .monton .pieza:hover {
      transform: translateY(-0.6rem) scale(1.04);
      position: relative;
      z-index: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pieza {
      transition: none;
    }
  }
</style>
