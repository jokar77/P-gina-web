# Cabeceras para Cloudflare Pages.
#
# Todo lo que Astro mete en /_astro/ lleva un hash del contenido en el nombre: si el
# archivo cambia, cambia el nombre. Así que se puede cachear para siempre sin riesgo de
# servir algo viejo. Cloudflare, por defecto, revalida en cada visita; esto se lo ahorra.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML sí tiene que revalidarse: es lo que cambia cuando ella edita una pieza.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
